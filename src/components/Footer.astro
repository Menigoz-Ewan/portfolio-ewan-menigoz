---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, type PageId } from '../data/site';

interface Props {
  active?: PageId | null;
}

const { active = null } = Astro.props;

const liens: { id: PageId; libelle: string; href: string }[] = [
  { id: 'projets', libelle: 'Projets', href: '/projets' },
  { id: 'galerie', libelle: 'Galerie', href: '/galerie' },
  { id: 'a-propos', libelle: 'À propos', href: '/a-propos' },
  { id: 'contact', libelle: 'Contact', href: '/contact' },
];
const legal = [
  { libelle: 'Mentions légales', href: '/mentions-legales' },
  { libelle: 'Usage de l’IA', href: '/usage-ia' },
  { libelle: 'Confidentialité', href: '/mentions-legales#donnees' },
];
const reseaux = [
  { libelle: 'E-mail', href: `mailto:${site.email}`, icone: 'mail' as const },
  { libelle: 'LinkedIn', href: site.linkedin || '/contact', icone: 'linkedin' as const },
  { libelle: 'Instagram', href: site.instagram || '/contact', icone: 'instagram' as const },
];
---

<footer class="relative z-10 border-t border-trait bg-fond">
  <div class="conteneur flex flex-col gap-8 pb-8 pt-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <a href="/" class="flex items-center gap-4 rounded">
        <Logo lien class="h-[30px] w-auto text-principal" />
        <span class="flex flex-col text-small">
          <span class="font-medium text-principal">{site.nom}</span>
          <span class="text-secondaire">{site.metier} · {site.ville}</span>
        </span>
      </a>
      <nav aria-label="Pied de page">
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-small text-secondaire">
          {
            liens.map((l) => (
              <li>
                <a
                  href={l.href}
                  aria-current={active === l.id ? "page" : undefined}
                  class="transition-colors duration-(--duree-lien) hover:text-principal aria-[current=page]:text-principal"
                >
                  {l.libelle}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ul class="flex gap-2">
        {
          reseaux.map((r) => (
            <li>
              <a
                href={r.href}
                aria-label={r.libelle}
                class="flex size-9 items-center justify-center rounded-md border border-trait-fort text-principal transition-colors duration-(--duree-bouton) hover:border-principal/35 hover:bg-surface"
              >
                <Icon nom={r.icone} taille={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="h-px bg-trait"></div>
    <div class="flex flex-col gap-3 text-small text-secondaire md:flex-row md:justify-between">
      <p>© 2026 {site.nom}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          legal.map((l) => (
            <li>
              <a href={l.href} class="transition-colors duration-(--duree-lien) hover:text-principal">
                {l.libelle}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
