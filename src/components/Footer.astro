---
import Logo from './Logo.astro';
import IconeAnimee from './IconeAnimee.astro';
import { site, textesSite, type PageId } from '../data/site';
import { langue, t, lien } from '../i18n';

interface Props {
  active?: PageId | null;
}

const { active = null } = Astro.props;

const lang = langue(Astro.currentLocale);
const ui = t(lang);
const liens: { id: PageId; libelle: string; href: string }[] = [
  { id: 'projets', libelle: ui.nav.projets, href: lien('projets', lang) },
  { id: 'galerie', libelle: ui.nav.galerie, href: lien('galerie', lang) },
  { id: 'a-propos', libelle: ui.nav['a-propos'], href: lien('a-propos', lang) },
  { id: 'contact', libelle: ui.contact, href: lien('contact', lang) },
];
const legal = [
  { libelle: ui.mentions, href: lien('mentions', lang) },
  { libelle: ui.usageIa, href: lien('ia', lang) },
  { libelle: ui.confidentialite, href: `${lien('mentions', lang)}#donnees` },
];
const reseaux = [
  { libelle: 'E-mail', href: `mailto:${site.email}`, icone: 'mail' as const },
  { libelle: 'LinkedIn', href: site.linkedin || lien('contact', lang), icone: 'linkedin' as const },
  { libelle: 'Instagram', href: site.instagram || lien('contact', lang), icone: 'instagram' as const },
];
---

<footer class="relative z-10 border-t border-trait bg-fond">
  <div class="conteneur flex flex-col gap-8 pb-8 pt-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <a href={lien('accueil', lang)} class="flex items-center gap-4 rounded">
        <Logo lien class="h-[30px] w-auto text-principal" />
        <span class="flex flex-col text-small">
          <span class="font-medium text-principal">{site.nom}</span>
          <span class="text-secondaire">{textesSite(lang).metier} · {site.ville}</span>
        </span>
      </a>
      <nav aria-label={ui.piedDePage}>
        <ul class="flex flex-wrap gap-x-6 gap-y-2 text-small text-secondaire">
          {
            liens.map((l) => (
              <li>
                <a
                  href={l.href}
                  aria-current={active === l.id ? "page" : undefined}
                  class="transition-colors duration-(--duree-lien) hover:text-principal aria-[current=page]:text-principal"
                >
                  {l.libelle}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ul class="flex gap-2">
        {
          reseaux.map((r) => (
            <li>
              <a
                href={r.href}
                aria-label={r.libelle}
                class="declencheur-icone flex size-9 items-center justify-center rounded-md border border-trait-fort text-principal transition-colors duration-(--duree-bouton) hover:border-principal/35 hover:bg-surface"
              >
                <IconeAnimee nom={r.icone} taille={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="h-px bg-trait"></div>
    <div class="flex flex-col gap-3 text-small text-secondaire md:flex-row md:justify-between">
      <p>© 2026 {site.nom}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          legal.map((l) => (
            <li>
              <a href={l.href} class="transition-colors duration-(--duree-lien) hover:text-principal">
                {l.libelle}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
