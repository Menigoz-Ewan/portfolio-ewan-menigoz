---
// En-tête des pages intérieures (l'accueil a son propre en-tête en onglet, voir HeroAccueil).
import Brand from './Brand.astro';
import NavLink from './NavLink.astro';
import Button from './Button.astro';
import MenuMobile from './MenuMobile.astro';
import { navigation } from '../data/site';

interface Props {
  actif?: string;
  pageContact?: boolean;
}

const { actif, pageContact = false } = Astro.props;
---

<header class="relative z-20 border-b border-sable-fonce bg-creme">
  <div class="conteneur flex h-16 items-center justify-between">
    <Brand />
    <nav aria-label="Navigation principale" class="hidden md:block">
      <ul class="flex gap-8">
        {
          navigation.map((lien) => (
            <li>
              <NavLink href={lien.href} actif={actif === lien.libelle}>
                {lien.libelle}
              </NavLink>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="hidden md:block">
      {
        pageContact ? (
          <Button href="/contact" variante="secondary" aria-current="page">
            Me contacter
          </Button>
        ) : (
          <Button href="/contact">Me contacter</Button>
        )
      }
    </div>
    <MenuMobile actif={actif} />
  </div>
</header>
