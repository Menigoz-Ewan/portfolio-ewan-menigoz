---
// Bloc commun à toutes les pages : barre de navigation + grand panneau vert.
// Sur les pages du menu, un onglet sort du haut du panneau, sous le lien actif.
// Les liens ont une position fixe : seul l'onglet change de place d'une page à l'autre.
import Brand from './Brand.astro';
import NavLink from './NavLink.astro';
import Button from './Button.astro';
import MenuMobile from './MenuMobile.astro';
import BoutonTheme from './BoutonTheme.astro';
import { navigation, type PageId } from '../data/site';

interface Props {
  /** Page dont le lien porte l'onglet ; null = panneau sans onglet (Contact, Mentions, Usage de l'IA, 404) */
  active?: PageId | null;
  /** « page » ajoute les marges internes des pages intérieures ; « libre » laisse la page gérer (accueil) */
  variante?: 'page' | 'libre';
}

const { active = null, variante = 'page' } = Astro.props;
---

<div class="relative z-20 mx-auto max-w-[1440px] px-3 pb-5 pt-4 lg:px-6 lg:pt-8">
  <!-- Barre de navigation : 64 px de haut, liens centrés à 64 px du haut de la page -->
  <!-- Entre 1024 et 1280 px, pas de marge intérieure : le menu et les boutons tiennent juste -->
  <header class="relative flex h-16 items-center justify-between px-2 lg:px-0 xl:px-20">
    <Brand />

    <!--
      Menu (maquette) : une case de 152 px par lien, texte et onglet centrés dedans ; les fantômes de 140 px
      laissent donc 12 px entre eux. Puis le bouton thème (12 px après) et « Me contacter » (16 px après).
      Entre 1024 et 1280 px, cases de 128 px pour que tout tienne (non dessiné dans la maquette).
    -->
    <div class="hidden items-center lg:flex">
      <nav aria-label="Navigation principale">
        <ul class="flex items-center">
          {
            navigation.map((lien) => (
              <li class="relative flex h-16 w-32 items-center justify-center xl:w-[152px]">
                {lien.id === active && <span class="onglet" aria-hidden="true" />}
                <NavLink href={lien.href} actif={lien.id === active}>
                  {lien.libelle}
                </NavLink>
              </li>
            ))
          }
        </ul>
      </nav>
      <BoutonTheme class="ml-3 mr-4" />
      <Button href="/contact">Me contacter</Button>
    </div>

    <MenuMobile active={active} />
  </header>

  <!--
    Panneau vert : coins arrondis de 40 px (28 px sous 1024 px).
    C'est la cible du lien « Aller au contenu » : il contient le titre (h1) de la page.
  -->
  <section
    id="contenu"
    tabindex="-1"
    aria-label="Présentation de la page"
    class:list={[
      'relative z-[2] rounded-[28px] bg-vert outline-none lg:rounded-[40px]', // z 2 : devant les pieds des fantômes du menu
      variante === 'page' && 'min-h-[244px] px-6 pb-10 pt-10 lg:px-20 lg:pb-14 lg:pt-[72px]',
    ]}
  >
    <slot />
  </section>
</div>

<style>
  /*
   * Onglet actif « pilule rebondissante » (variante B du canvas Claude Design) : 128 × 38 px au total,
   * centré sur le lien et posé sur le panneau (le bas de la barre = le haut du panneau).
   * Un dessus de 108 px en demi-cercle (coins de 19 px) et deux petites « oreilles » de 10 px
   * qui le raccordent au panneau par une courbe creuse.
   */
  .onglet {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 108px;
    height: 38px;
    border-radius: 19px 19px 0 0;
    translate: -50% 0;
    z-index: 2; /* devant les fantômes voisins (remplissage et trait), comme le panneau dans la maquette */
    background: var(--color-vert);
    view-transition-name: onglet;
  }
  .onglet::before,
  .onglet::after {
    content: '';
    position: absolute;
    bottom: 0;
    width: 10px;
    height: 10px;
    background: inherit;
  }
  /* 1 px de recouvrement pour éviter un liseré entre l'onglet et ses oreilles */
  .onglet::before {
    right: calc(100% - 1px);
    clip-path: path('M0 10Q10 10 10 0V10Z');
  }
  .onglet::after {
    left: calc(100% - 1px);
    clip-path: path('M10 10Q0 10 0 0V10Z');
  }
</style>
