---
// « Ce qui nourrit mon regard » : anneau 3D de polaroïds (variante A du canvas Claude Design,
// inspirée de « Circular Carousel »). Les 9 cartes forment un cercle ; l'anneau tourne pour amener
// une passion devant : flèches, clic sur une carte, ou focus clavier (Tab) sur une carte.
// Avec « réduire les animations » : l'anneau change de position sans mouvement.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { langue } from '../i18n';
import photographie from '../assets/images/hors-ecran/photographie.png';
import musique from '../assets/images/hors-ecran/musique.png';
import cinema from '../assets/images/hors-ecran/cinema.png';
import jeuxVideo from '../assets/images/hors-ecran/jeux-video.png';
import mangas from '../assets/images/hors-ecran/mangas.png';
import architecture from '../assets/images/hors-ecran/architecture.png';
import nature from '../assets/images/hors-ecran/nature.png';
import dessin from '../assets/images/hors-ecran/dessin.png';
import mode from '../assets/images/hors-ecran/mode.png';

const cartes = [
  { titre: 'Photographie', src: photographie, alt: 'Appareil photo noir et sa sangle, posés sur une table claire' },
  { titre: 'Musique', src: musique, alt: 'Batterie et cymbales sur un tapis, dans une pièce sombre' },
  { titre: 'Cinéma', src: cinema, alt: 'Ancien projecteur de cinéma à bobines' },
  { titre: 'Jeux vidéo', src: jeuxVideo, alt: 'Manette de jeu vidéo rouge posée sur un tapis de bureau' },
  { titre: 'Mangas', src: mangas, alt: 'Bibliothèque en bois remplie de mangas' },
  { titre: 'Architecture', src: architecture, alt: 'Deux façades métalliques courbes vues en contre-plongée, le ciel nuageux entre elles' },
  { titre: 'Nature', src: nature, alt: 'Sous-bois en automne vu du sol : feuilles mortes au premier plan, arbres et lumière au-dessus' },
  { titre: 'Dessin', src: dessin, alt: 'Carnet de croquis ouvert sur des portraits dessinés au crayon' },
  { titre: 'Mode', src: mode, alt: 'Vêtements violets, turquoise et gris suspendus côte à côte' },
];
const lang = langue(Astro.currentLocale);
// Titres et textes alternatifs en anglais, dans le même ordre que les cartes
const en = [
  ['Photography', 'Black camera and its strap on a light table'],
  ['Music', 'Drum kit and cymbals on a rug, in a dark room'],
  ['Cinema', 'Old reel-to-reel film projector'],
  ['Video games', 'Red game controller on a desk mat'],
  ['Manga', 'Wooden bookcase full of manga'],
  ['Architecture', 'Two curved metal façades seen from below, with a cloudy sky between them'],
  ['Nature', 'Autumn undergrowth seen from the ground: dead leaves in the foreground, trees and light above'],
  ['Drawing', 'Open sketchbook with pencil portraits'],
  ['Fashion', 'Purple, turquoise and grey clothes hanging side by side'],
];
const cartesPage = lang === 'en' ? cartes.map((c, i) => ({ ...c, titre: en[i][0], alt: en[i][1] })) : cartes;
const T = {
  fr: { precedente: 'Passion précédente', suivante: 'Passion suivante' },
  en: { precedente: 'Previous interest', suivante: 'Next interest' },
}[lang];
// Angle entre deux cartes sur le cercle
const pas = 360 / cartes.length;
---

<div class="scene" data-anneau style={`--pas: ${pas}deg`}>
  <ul class="anneau" data-piste>
    {
      cartesPage.map((c, i) => (
        <li class="emplacement" style={`--i: ${i}`}>
          <button type="button" class="polaroid" aria-pressed={i === 0 ? 'true' : 'false'} data-index={i}>
            <Image src={c.src} alt={c.alt} width={300} height={300} class="aspect-square w-full rounded-[4px] object-cover" />
            <span class="text-small text-principal">{c.titre}</span>
          </button>
        </li>
      ))
    }
  </ul>
  <div class="commandes">
    <button type="button" class="fleche" aria-label={T.precedente} data-precedent>
      <span class="inline-flex rotate-180"><Icon nom="arrow-right" taille={18} /></span>
    </button>
    <p class="titre-courant text-label text-vert-texte" aria-live="polite" data-titre>{cartesPage[0].titre}</p>
    <button type="button" class="fleche" aria-label={T.suivante} data-suivant>
      <Icon nom="arrow-right" taille={18} />
    </button>
  </div>
</div>

<style>
  /* Scène en perspective, sans fond : les polaroïds flottent sur la page ; le rayon s'adapte à la taille des cartes */
  .scene {
    --largeur: 170px;
    --rayon: 330px;
    position: relative;
    height: 440px;
    overflow: hidden;
    perspective: 1200px;
  }
  .anneau {
    --rotation: 0deg;
    position: absolute;
    left: 50%;
    top: 60px;
    width: var(--largeur);
    margin-left: calc(var(--largeur) / -2);
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--rayon) * -1)) rotateY(var(--rotation));
    transition: transform 800ms var(--ease-sortie);
  }
  /* Chaque carte est tournée de son angle puis poussée sur le cercle */
  .emplacement {
    position: absolute;
    inset: 0 0 auto;
    transform: rotateY(calc(var(--i) * var(--pas))) translateZ(var(--rayon));
    backface-visibility: hidden;
  }
  .polaroid {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 6px 6px 10px;
    border-radius: 8px;
    background: var(--color-carte);
    box-shadow: 0 10px 24px rgb(0 0 0 / 0.14);
    filter: brightness(0.75);
    transition:
      filter 400ms ease,
      box-shadow 400ms ease,
      scale 450ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  /* Survol : le polaroïd grossit un peu et s'éclaire */
  .polaroid:hover {
    scale: 1.08;
    filter: none;
  }
  .polaroid[aria-pressed='true'] {
    filter: none;
    box-shadow:
      0 0 0 1.5px var(--color-vert-texte),
      0 18px 36px rgb(0 0 0 / 0.18);
  }
  .polaroid:focus-visible {
    outline: 2.5px solid var(--color-vert-texte);
    outline-offset: 3px;
  }
  .commandes {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .titre-courant {
    min-width: 120px;
    text-align: center;
  }
  .fleche {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--color-trait-fort);
    background: var(--color-carte);
    color: var(--color-principal);
    transition: background-color var(--duree-bouton);
  }
  .fleche:hover {
    background: var(--color-surface-forte);
  }
  .fleche:focus-visible {
    outline: 2.5px solid var(--color-vert-texte);
    outline-offset: 2px;
  }
  /* Petits écrans : cartes et cercle plus petits */
  @media (max-width: 640px) {
    .scene {
      --largeur: 120px;
      --rayon: 210px;
      height: 360px;
    }
    .anneau {
      top: 50px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .anneau,
    .polaroid {
      transition: none;
    }
  }
</style>

<script>
  for (const scene of document.querySelectorAll<HTMLElement>('[data-anneau]')) {
    const anneau = scene.querySelector<HTMLElement>('[data-piste]')!;
    const cartes = [...scene.querySelectorAll<HTMLButtonElement>('.polaroid')];
    const titre = scene.querySelector<HTMLElement>('[data-titre]')!;
    const pas = 360 / cartes.length;
    let tour = 0; // position « déroulée » : permet de tourner toujours dans le sens le plus court

    const montrer = (index: number) => {
      // Écart le plus court entre la carte devant et la carte demandée
      const actuel = ((tour % cartes.length) + cartes.length) % cartes.length;
      let ecart = index - actuel;
      if (ecart > cartes.length / 2) ecart -= cartes.length;
      if (ecart < -cartes.length / 2) ecart += cartes.length;
      tour += ecart;
      anneau.style.setProperty('--rotation', `${-tour * pas}deg`);
      cartes.forEach((c, i) => {
        c.setAttribute('aria-pressed', String(i === index));
        // Distance (en cartes) à la carte de devant. Au-delà de 2, la carte tourne le dos (déjà invisible) : elle est
        // retirée de la tabulation ; à 2, elle est en partie cachée : plus cliquable. Les flèches atteignent toutes les cartes.
        const d = Math.min(Math.abs(i - index), cartes.length - Math.abs(i - index));
        c.style.visibility = d > 2 ? 'hidden' : '';
        c.style.pointerEvents = d <= 1 ? '' : 'none';
      });
      titre.textContent = cartes[index].querySelector('span')?.textContent ?? '';
    };
    const courant = () => ((tour % cartes.length) + cartes.length) % cartes.length;

    scene.querySelector('[data-precedent]')!.addEventListener('click', () => montrer((courant() - 1 + cartes.length) % cartes.length));
    scene.querySelector('[data-suivant]')!.addEventListener('click', () => montrer((courant() + 1) % cartes.length));
    cartes.forEach((c, i) => {
      c.addEventListener('click', () => montrer(i));
      c.addEventListener('focus', () => montrer(i));
    });
    montrer(0); // état de départ : cartes cliquables autour de la première
  }
</script>
