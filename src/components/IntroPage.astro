---
// Titre + intro des pages intérieures, posés dans le panneau vert du header.
// League Spartan SemiBold 56/60 crème (une ligne en desktop, comme la maquette),
// intro DM Sans 18/28 crème à 80 %, 680 px de large au maximum.
interface Props {
  titre: string;
  chapo?: string;
  class?: string;
}

const { titre, chapo, class: classe = '' } = Astro.props;
---

<div class:list={['flex flex-col items-start gap-6', classe]}>
  <h1 class="max-w-[960px] text-display text-creme">{titre}</h1>
  {chapo && <p class="max-w-[680px] text-lead text-creme/80">{chapo}</p>}
  <slot />
</div>
