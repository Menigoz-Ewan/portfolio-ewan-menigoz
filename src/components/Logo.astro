---
// Logo typographique EWME : E, W, M puis un E retourné comme une parenthèse.
// Même espace entre toutes les lettres. En currentColor pour passer en encre ou en crème.
// viewBox élargi d'1 unité de chaque côté : sans cette marge, le bord droit du dernier E
// tombait sur une fraction de pixel et paraissait coupé.
//
// Survol (ou focus clavier) du lien qui contient le logo : il rejoue en petit l'animation de l'écran
// de chargement « Les parenthèses » — les deux E se rejoignent au centre, puis s'écartent pendant
// que le WM réapparaît en tournant (en vert), et tout revient en place.
interface Props {
  /** true quand le logo sert de lien vers l'accueil : il reçoit alors un nom accessible */
  lien?: boolean;
  class?: string;
}

const { lien = false, class: classe = '' } = Astro.props;
const accessibilite = lien ? { role: 'img', 'aria-label': 'EWME, accueil' } : { 'aria-hidden': 'true' as const };
---

<svg viewBox="-1 0 394 164" overflow="visible" fill="none" xmlns="http://www.w3.org/2000/svg" class:list={['logo-ewme', classe]} focusable="false" {...accessibilite} data-logo>
  <path class="logo-e" d="M61.3636 0V13.0909H13.0909V75.2727H61.3636V88.3636H13.0909V150.545H61.3636V163.636H0V0H61.3636Z" fill="currentColor"></path>
  <g class="logo-wm">
    <path d="M110.452 0H97.3613V163.636H110.452L138.27 129.273L164.452 163.636H177.543V0H164.452V139.909L138.27 105.955L110.452 140.164V0Z" fill="currentColor"></path>
    <path d="M227.091 163.636H214V0H227.091L254.909 34.3636L281.091 0H294.182V163.636H281.091V23.7273L254.909 57.6818L227.091 23.4725V163.636Z" fill="currentColor"></path>
  </g>
  <path class="logo-e2" d="M330.182 0V13.0909H378.454V75.2727H330.182V88.3636H378.454V150.545H330.182V163.636H391.545V0H330.182Z" fill="currentColor"></path>
</svg>

<style>
  /* Les distances sont en unités du dessin (le viewBox) : 132 = les deux E collés au centre */
  .logo-wm {
    transform-box: fill-box;
    transform-origin: center;
  }
  .logo-anime .logo-e {
    animation: logo-e 1300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .logo-anime .logo-e2 {
    animation: logo-e2 1300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .logo-anime .logo-wm {
    animation: logo-wm 1300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes logo-e {
    30% {
      transform: translateX(132px);
    }
    65% {
      transform: translateX(-40px);
    }
  }
  @keyframes logo-e2 {
    30% {
      transform: translateX(-132px);
    }
    65% {
      transform: translateX(40px);
    }
  }
  @keyframes logo-wm {
    20% {
      opacity: 0;
      transform: scale(0.3);
    }
    35% {
      opacity: 0;
      transform: scale(0.3);
    }
    55% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
      color: var(--color-vert-texte);
    }
    90% {
      transform: scale(1) rotate(360deg);
      color: var(--color-vert-texte);
    }
    100% {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-anime .logo-e,
    .logo-anime .logo-e2,
    .logo-anime .logo-wm {
      animation: none;
    }
  }
</style>

<script>
  // Lance l'animation au survol ou au focus du lien parent ; elle se joue jusqu'au bout, une fois par passage.
  for (const logo of document.querySelectorAll<SVGElement>('[data-logo]')) {
    const declencheur = logo.closest('a') ?? logo;
    const lancer = () => {
      if (logo.classList.contains('logo-anime')) return;
      logo.classList.add('logo-anime');
    };
    declencheur.addEventListener('mouseenter', lancer);
    declencheur.addEventListener('focus', lancer);
    logo.querySelector('.logo-wm')!.addEventListener('animationend', () => logo.classList.remove('logo-anime'));
  }
</script>
