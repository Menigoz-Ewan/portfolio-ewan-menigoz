---
// Menu des écrans de moins de 1024 px : bouton « Menu » qui ouvre un panneau sous la barre.
import Button from './Button.astro';
import { navigation, type PageId } from '../data/site';

interface Props {
  active?: PageId | null;
}

const { active = null } = Astro.props;
---

<div class="lg:hidden" data-menu-mobile>
  <button
    type="button"
    aria-expanded="false"
    aria-controls="menu-mobile"
    class="flex h-11 items-center gap-2 rounded-lg border border-bordure bg-sable px-4 text-ui text-encre"
    data-menu-bouton
  >
    <span data-menu-libelle>Menu</span>
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none">
      <path d="M2.5 5h11M2.5 11h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
    </svg>
  </button>
  <nav
    id="menu-mobile"
    aria-label="Navigation principale"
    class="absolute inset-x-0 top-full z-30 mt-2 hidden rounded-2xl border border-sable-fonce bg-creme px-5 pb-6 pt-2 shadow-[0_12px_24px_rgb(22_22_22/0.12)]"
    data-menu-panneau
  >
    <ul class="flex flex-col">
      {
        navigation.map((lien) => (
          <li>
            <a
              href={lien.href}
              aria-current={active === lien.id ? 'page' : undefined}
              class:list={[
                'flex items-center justify-between border-b border-sable-fonce py-3 text-lead',
                active === lien.id ? 'font-medium text-vert' : 'text-encre',
              ]}
            >
              {lien.libelle}
              {active === lien.id && <span aria-hidden="true" class="size-2 rounded-full bg-vert" />}
            </a>
          </li>
        ))
      }
    </ul>
    <Button href="/contact" class="mt-5">Me contacter</Button>
  </nav>
</div>

<script>
  // Ouverture / fermeture du menu, fermeture avec Échap (QUALITE A1).
  for (const menu of document.querySelectorAll<HTMLElement>('[data-menu-mobile]')) {
    const bouton = menu.querySelector<HTMLButtonElement>('[data-menu-bouton]')!;
    const panneau = menu.querySelector<HTMLElement>('[data-menu-panneau]')!;
    const libelle = menu.querySelector<HTMLElement>('[data-menu-libelle]')!;

    const basculer = (ouvert: boolean) => {
      bouton.setAttribute('aria-expanded', String(ouvert));
      panneau.classList.toggle('hidden', !ouvert);
      libelle.textContent = ouvert ? 'Fermer' : 'Menu';
    };

    bouton.addEventListener('click', () => basculer(bouton.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && bouton.getAttribute('aria-expanded') === 'true') {
        basculer(false);
        bouton.focus();
      }
    });
  }
</script>
