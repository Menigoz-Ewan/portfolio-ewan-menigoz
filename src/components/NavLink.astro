---
// Lien du menu : toute la case (64 px de haut, 152 px de large) est cliquable.
// Inactif : contour d'onglet en pointillé derrière le texte (« onglet fantôme », comme un intercalaire
// de classeur vide). Au survol et au focus clavier, il se remplit et son trait devient plein.
// Actif : posé sur l'onglet vert (dessiné par HeaderPanneau), texte crème, sans fantôme.
//
// Empilement, comme dans la maquette : fantômes (z 0 et 1) < onglet vert et panneau (z 2) < textes (z 3).
// Les pieds des fantômes passent donc derrière l'onglet actif et le bord du panneau.
interface Props {
  href: string;
  actif?: boolean;
}

const { href, actif = false } = Astro.props;
// Même silhouette que l'onglet vert : pilule de 128 × 38 px (dessus en demi-cercle, oreilles creuses de 10 px)
const chemin = 'M0 38Q10 38 10 28V19A19 19 0 0 1 29 0H99A19 19 0 0 1 118 19V28Q118 38 128 38';
---

{
  actif ? (
    <a href={href} aria-current="page" class="relative z-[3] flex h-16 items-end justify-center rounded pb-[9px] text-ui text-creme focus-visible:outline-creme">
      <slot />
    </a>
  ) : (
    <a href={href} class="lien-fantome relative flex h-16 w-full items-end justify-center pb-[9px] text-ui text-principal">
      <svg class="fantome fantome-fond" width="128" height="38" viewBox="0 0 128 38" aria-hidden="true" focusable="false">
        <path d={chemin} />
      </svg>
      <svg class="fantome fantome-trait" width="128" height="38" viewBox="0 0 128 38" fill="none" aria-hidden="true" focusable="false">
        <path d={chemin} />
      </svg>
      <span class="relative z-[3]">
        <slot />
      </span>
    </a>
  )
}

<style>
  /*
   * Contour fantôme : 128 × 38 px (la silhouette de l'onglet vert), centré dans la case du lien (trait encre, pointillé 4 / 4, comme la maquette).
   */
  .fantome {
    position: absolute;
    left: 50%;
    bottom: 0;
    translate: -50% 0;
    overflow: visible;
    pointer-events: none;
  }
  .fantome-fond {
    z-index: 0;
  }
  .fantome-fond path {
    stroke: none;
    fill: transparent;
    transition: fill var(--duree-lien) var(--ease-sortie);
  }
  .fantome-trait {
    z-index: 1;
  }
  .fantome-trait path {
    stroke: var(--role-fantome-trait);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }
  /* Survol et focus clavier : remplissage sable, trait plein */
  .lien-fantome:hover .fantome-fond path,
  .lien-fantome:focus-visible .fantome-fond path {
    fill: var(--role-fantome-fond);
  }
  .lien-fantome:hover .fantome-trait path,
  .lien-fantome:focus-visible .fantome-trait path {
    stroke-dasharray: none;
  }
</style>
