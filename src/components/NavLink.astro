---
// Lien de navigation.
// Inactif : gris, soulignement vert qui s'étire de 4 à 16 px au survol (220 ms).
// Actif : posé sur l'onglet vert, texte crème, focus crème pour rester visible sur le vert.
interface Props {
  href: string;
  actif?: boolean;
  surOnglet?: boolean;
}

const { href, actif = false, surOnglet = false } = Astro.props;
---

{
  surOnglet ? (
    <a href={href} aria-current="page" class="relative rounded text-ui text-creme focus-visible:outline-creme">
      <slot />
    </a>
  ) : (
    <a
      href={href}
      aria-current={actif ? 'page' : undefined}
      class:list={[
        'group relative flex flex-col items-center gap-1.5 pt-2 text-ui transition-colors duration-(--duree-lien) ease-(--ease-sortie)',
        actif ? 'text-principal' : 'text-secondaire hover:text-principal',
      ]}
    >
      <slot />
      <span
        aria-hidden="true"
        class:list={[
          'h-0.5 bg-vert transition-[width,opacity] duration-(--duree-lien) ease-(--ease-sortie)',
          actif ? 'w-4 opacity-100' : 'w-1 opacity-0 group-hover:w-4 group-hover:opacity-100',
        ]}
      />
    </a>
  )
}
