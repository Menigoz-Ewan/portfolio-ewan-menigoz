---
// Lien du menu : toute la case (64 px de haut, 152 px de large) est cliquable.
// Inactif : contour d'onglet en pointillé derrière le texte (« onglet fantôme », comme un intercalaire
// de classeur vide). Au survol et au focus clavier, il se remplit et son trait devient plein.
// Actif : posé sur l'onglet vert (dessiné par HeaderPanneau), texte crème, sans fantôme.
//
// Empilement, comme dans la maquette : fantômes (z 0 et 1) < onglet vert et panneau (z 2) < textes (z 3).
// Les pieds des fantômes passent donc derrière l'onglet actif et le bord du panneau.
interface Props {
  href: string;
  actif?: boolean;
}

const { href, actif = false } = Astro.props;
const chemin = 'M0 64C14 64 18 58 20 46L26 14C28 4 34 0 44 0H96C106 0 112 4 114 14L120 46C122 58 126 64 140 64';
---

{
  actif ? (
    <a href={href} aria-current="page" class="relative z-[3] flex h-16 items-center justify-center rounded text-ui text-creme focus-visible:outline-creme">
      <slot />
    </a>
  ) : (
    <a href={href} class="lien-fantome relative flex h-16 w-full items-center justify-center text-ui text-principal">
      <svg class="fantome fantome-fond" width="140" height="64" viewBox="0 0 140 64" aria-hidden="true" focusable="false">
        <path d={chemin} />
      </svg>
      <svg class="fantome fantome-trait" width="140" height="64" viewBox="0 0 140 64" fill="none" aria-hidden="true" focusable="false">
        <path d={chemin} />
      </svg>
      <span class="relative z-[3]">
        <slot />
      </span>
    </a>
  )
}

<style>
  /*
   * Contour fantôme : 140 × 64 px, centré dans la case du lien (trait encre, pointillé 4 / 4, comme la maquette).
   */
  .fantome {
    position: absolute;
    left: 50%;
    bottom: 0;
    translate: -50% 0;
    overflow: visible;
    pointer-events: none;
  }
  .fantome-fond {
    z-index: 0;
  }
  .fantome-fond path {
    stroke: none;
    fill: transparent;
    transition: fill var(--duree-lien) var(--ease-sortie);
  }
  .fantome-trait {
    z-index: 1;
  }
  .fantome-trait path {
    stroke: var(--role-fantome-trait);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }
  /* Survol et focus clavier : remplissage sable, trait plein */
  .lien-fantome:hover .fantome-fond path,
  .lien-fantome:focus-visible .fantome-fond path {
    fill: var(--role-fantome-fond);
  }
  .lien-fantome:hover .fantome-trait path,
  .lien-fantome:focus-visible .fantome-trait path {
    stroke-dasharray: none;
  }
</style>
