---
// Mise en page des pages « document » (Mentions légales, Usage de l'IA) :
// sommaire collant à gauche, sections en cartes numérotées à droite.
interface Props {
  sections: { id: string; titre: string }[];
}

const { sections } = Astro.props;
---

<div class="conteneur flex flex-col gap-6 pb-24 lg:flex-row lg:items-start">
  <nav
    aria-label="Sommaire"
    class="flex flex-col gap-1 rounded-2xl border border-sable-fonce bg-white p-5 lg:sticky lg:top-6 lg:w-[282px] lg:shrink-0"
    data-sommaire
  >
    <p class="text-label text-texte-secondaire">Sommaire</p>
    <ol>
      {
        sections.map((s, i) => (
          <li>
            <a
              href={`#${s.id}`}
              class="lien-sommaire flex items-center gap-2.5 border-l-2 border-transparent py-2 pl-2.5 text-ui text-texte-secondaire transition-colors hover:text-encre"
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span class="text-label text-vert">{String(i + 1).padStart(2, '0')}</span>
              {s.titre}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="flex flex-1 flex-col gap-4">
    <slot />
  </div>
</div>

<style>
  .lien-sommaire[aria-current='true'] {
    border-color: var(--color-vert);
    color: var(--color-encre);
  }
</style>

<script>
  // Met en évidence, dans le sommaire, la section en cours de lecture.
  const liens = [...document.querySelectorAll<HTMLAnchorElement>('[data-sommaire] a')];
  const observateur = new IntersectionObserver(
    (entrees) => {
      for (const entree of entrees) {
        if (!entree.isIntersecting) continue;
        for (const l of liens) {
          if (l.hash === `#${entree.target.id}`) l.setAttribute('aria-current', 'true');
          else l.removeAttribute('aria-current');
        }
      }
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  for (const l of liens) {
    const cible = document.querySelector(l.hash);
    if (cible) observateur.observe(cible);
  }
</script>
