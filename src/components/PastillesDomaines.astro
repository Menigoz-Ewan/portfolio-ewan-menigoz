---
// Pastilles des domaines MMI (Dev, Créa, Com) : une pastille par domaine, avec son pictogramme.
// « carte » : vert plein, nom court (cartes projet). « entete » : crème sur le panneau vert, nom complet (étude de cas).
import IconeAnimee from './IconeAnimee.astro';
import { domainesPour, trierDomaines, type Categorie } from '../data/projets';
import { langue } from '../i18n';

interface Props {
  categories: Categorie[];
  variante?: 'carte' | 'entete';
}

const { categories, variante = 'carte' } = Astro.props;
const enTete = variante === 'entete';
const lang = langue(Astro.currentLocale);
const domaines = domainesPour(lang);
---

<ul aria-label={lang === 'en' ? 'Fields' : 'Domaines'} class="flex flex-wrap gap-1.5">
  {
    trierDomaines(categories).map((id) => (
      <li
        class:list={[
          'inline-flex items-center rounded-full text-label',
          enTete ? 'gap-2 bg-creme py-1.5 pl-3 pr-3.5 text-vert' : 'gap-1.5 bg-vert py-1 pl-2 pr-2.5 text-creme',
        ]}
      >
        <IconeAnimee nom={domaines[id].icone} taille={enTete ? 16 : 13} />
        {enTete ? domaines[id].long : domaines[id].court}
      </li>
    ))
  }
</ul>
