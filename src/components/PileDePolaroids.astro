---
// Pile de polaroids du hero : la photo du dessus passe derrière toutes les 4 s.
// Bouton pause accessible (WCAG 2.2.2) ; aucune animation automatique si l'utilisateur réduit les animations.
import { Image } from 'astro:assets';
import portrait from '../assets/images/portrait-ewan.png';
import chateau from '../assets/images/affiche-chateau.png';
import exposition from '../assets/images/polaroid-exposition.png';
import cimade from '../assets/images/polaroid-cimade.png';

const photos = [
  { src: portrait, alt: 'Portrait d’Ewan Menigoz en noir et blanc', titre: 'Ewan, Montbéliard', type: 'Photo de moi' },
  { src: chateau, alt: 'Affiche du château des ducs de Wurtemberg', titre: 'Affiche · Château', type: 'Projet' },
  { src: exposition, alt: 'Œuvres accrochées lors d’une exposition', titre: 'Exposition', type: 'Ambiance' },
  { src: cimade, alt: 'Affiche réalisée pour La Cimade', titre: 'La Cimade', type: 'Projet' },
];
---

<div class="pile relative h-[480px] w-[420px]" data-pile>
  <ul class="relative h-full w-full" aria-label="Photos : portrait et projets">
    {
      photos.map((p, i) => (
        <li class="polaroid absolute left-[60px] top-[52px] w-[300px]" data-pos={i} aria-hidden={i === 0 ? undefined : 'true'}>
          <figure class="flex flex-col gap-3 rounded-[14px] border border-sable-fonce bg-white px-3 pb-4 pt-3 shadow-[0_18px_36px_rgb(0_0_0/0.22)]">
            <Image
              src={p.src}
              alt={p.alt}
              width={552}
              height={600}
              class="h-[300px] w-[276px] rounded-lg bg-sable object-cover"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
            <figcaption class="legende flex items-center justify-between">
              <span class="text-ui text-encre">{p.titre}</span>
              <span class="text-label text-texte-secondaire">{p.type}</span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
  <button
    type="button"
    class="absolute -bottom-2 left-4 flex h-9 items-center gap-2 rounded-full bg-creme/15 px-3 text-ui text-creme backdrop-blur-sm transition-colors duration-(--duree-bouton) hover:bg-creme/25 focus-visible:outline-white"
    aria-pressed="false"
    data-pile-pause
  >
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" data-icone-pause>
      <rect x="3" y="2" width="2.5" height="10" rx="1" fill="currentColor"></rect>
      <rect x="8.5" y="2" width="2.5" height="10" rx="1" fill="currentColor"></rect>
    </svg>
    <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" class="hidden" data-icone-lecture>
      <path d="M4 2.5v9l7.5-4.5z" fill="currentColor"></path>
    </svg>
    <span data-pause-libelle>Pause</span>
  </button>
</div>

<style>
  /* Position de chaque photo dans la pile : 0 = dessus. */
  .polaroid {
    transition:
      transform 600ms cubic-bezier(0.65, 0, 0.35, 1),
      z-index 600ms steps(1, end);
  }
  .polaroid[data-pos='0'] {
    transform: rotate(3deg);
    z-index: 40;
  }
  .polaroid[data-pos='1'] {
    transform: translate(6px, 4px) rotate(-5deg);
    z-index: 30;
  }
  .polaroid[data-pos='2'] {
    transform: translate(-14px, 6px) rotate(7deg);
    z-index: 20;
  }
  .polaroid[data-pos='3'] {
    transform: translate(-6px, 10px) rotate(-9deg);
    z-index: 10;
  }
  /* La photo qui quitte le dessus glisse vers la droite avant de passer derrière. */
  .polaroid.sortie {
    transform: translate(180px, -20px) rotate(14deg);
    z-index: 40;
    transition: transform 350ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .legende {
    transition: opacity 450ms ease-out;
  }
  .polaroid:not([data-pos='0']) .legende {
    opacity: 0;
  }
</style>

<script>
  const INTERVALLE = 4000;

  for (const pile of document.querySelectorAll<HTMLElement>('[data-pile]')) {
    const photos = [...pile.querySelectorAll<HTMLElement>('.polaroid')];
    const bouton = pile.querySelector<HTMLButtonElement>('[data-pile-pause]')!;
    const libelle = bouton.querySelector<HTMLElement>('[data-pause-libelle]')!;
    const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let minuteur: number | undefined;

    const suivante = () => {
      const dessus = photos.find((p) => p.dataset.pos === '0');
      if (!dessus) return;
      dessus.classList.add('sortie');
      window.setTimeout(() => {
        dessus.classList.remove('sortie');
        for (const p of photos) {
          const pos = Number(p.dataset.pos);
          p.dataset.pos = String(pos === 0 ? photos.length - 1 : pos - 1);
          if (p.dataset.pos === '0') p.removeAttribute('aria-hidden');
          else p.setAttribute('aria-hidden', 'true');
        }
      }, 350);
    };

    const lancer = () => {
      minuteur = window.setInterval(suivante, INTERVALLE);
      bouton.setAttribute('aria-pressed', 'false');
      libelle.textContent = 'Pause';
      bouton.querySelector('[data-icone-pause]')?.classList.remove('hidden');
      bouton.querySelector('[data-icone-lecture]')?.classList.add('hidden');
    };
    const arreter = () => {
      window.clearInterval(minuteur);
      minuteur = undefined;
      bouton.setAttribute('aria-pressed', 'true');
      libelle.textContent = 'Lecture';
      bouton.querySelector('[data-icone-pause]')?.classList.add('hidden');
      bouton.querySelector('[data-icone-lecture]')?.classList.remove('hidden');
    };

    bouton.addEventListener('click', () => (minuteur ? arreter() : lancer()));
    if (reduit) arreter();
    else lancer();
  }
</script>
