---
// Carte projet : toute la carte est cliquable quand une étude de cas existe.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import PastillesDomaines from './PastillesDomaines.astro';
import type { Categorie, Visuel } from '../data/projets';

interface Props {
  titre: string;
  categories: Categorie[];
  sousDomaines: string[];
  resume: string;
  vignette: Visuel;
  href?: string;
  class?: string;
}

const { titre, categories, sousDomaines, resume, vignette, href, class: classe = '' } = Astro.props;
const Balise = href ? 'a' : 'article';
---

<Balise
  href={href}
  class:list={[
    'carte-projet group flex flex-col rounded-2xl border border-trait bg-carte px-2.5 pt-2.5',
    'transition-[border-color,box-shadow,translate] duration-(--duree-carte) ease-(--ease-sortie)',
    href && 'hover:-translate-y-1 hover:border-vert-texte hover:shadow-[0_14px_28px_rgb(23_23_23/0.08)] focus-visible:outline-offset-4 focus-visible:rounded-2xl',
    classe,
  ]}
>
  <div class="relative h-[228px] overflow-hidden rounded-[10px] bg-surface">
    <Image src={vignette.src} alt={href ? '' : vignette.alt} width={728} height={456} class="size-full object-cover" />
    {
      href && (
        <>
          <div aria-hidden="true" class="absolute inset-0 bg-fond opacity-0 transition-opacity duration-(--duree-carte) group-hover:opacity-40" />
          <span
            aria-hidden="true"
            class="absolute left-1/2 top-1/2 inline-flex -translate-x-1/2 translate-y-[-30%] items-center gap-2 rounded-lg bg-rouge px-5 py-3 text-button text-white opacity-0 shadow-[0_4px_12px_rgb(206_26_27/0.25)] transition-[opacity,translate] duration-(--duree-carte) ease-(--ease-sortie) group-hover:-translate-y-1/2 group-hover:opacity-100"
          >
            Voir plus
            <Icon nom="arrow-right" />
          </span>
        </>
      )
    }
  </div>
  <div class="flex flex-col gap-2 px-1.5 pb-[18px] pt-3.5">
    <!-- Domaines MMI en pastilles, puis sous-domaines en mots-clés sous le titre -->
    <PastillesDomaines categories={categories} />
    <div class="flex items-center gap-3">
      <h3 class="flex-1 text-h3 text-principal">{titre}</h3>
      {
        href && (
          <span class="text-secondaire transition-[color,translate] duration-(--duree-carte) ease-(--ease-sortie) group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-vert-texte">
            <Icon nom="arrow-up-right" taille={20} />
          </span>
        )
      }
    </div>
    <p class="text-label text-secondaire">{sousDomaines.join(' · ')}</p>
    <p class="text-small text-secondaire">{resume}</p>
  </div>
</Balise>
