---
// Carte de section numérotée d'une page « document ».
interface Props {
  id: string;
  numero: number;
  titre: string;
}

const { id, numero, titre } = Astro.props;
---

<section id={id} aria-labelledby={`titre-${id}`} class="flex scroll-mt-6 flex-col gap-4 rounded-2xl border border-trait bg-carte p-6 md:p-7">
  <div class="flex items-center gap-3">
    <span class="rounded bg-vert px-2 py-1 text-label text-white">{String(numero).padStart(2, '0')}</span>
    <h2 id={`titre-${id}`} class="text-h3">{titre}</h2>
  </div>
  <div class="flex flex-col gap-6 text-body text-secondaire">
    <slot />
  </div>
</section>
