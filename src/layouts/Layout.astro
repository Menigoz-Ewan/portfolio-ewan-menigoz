---
import '../styles/global.css';
import filaire from '../assets/svg/ewme-filaire-large.svg?raw';
import HeaderPanneau from '../components/HeaderPanneau.astro';
import Footer from '../components/Footer.astro';
import EcranChargement from '../components/EcranChargement.astro';
import { site, type PageId } from '../data/site';

interface Props {
  titre: string;
  description?: string;
  /** Page active : place l'onglet du header (null = pas d'onglet) et marque le lien du pied de page */
  active?: PageId | null;
  /** « libre » sur l'accueil, dont le hero gère ses propres marges dans le panneau */
  variantePanneau?: 'page' | 'libre';
  /** Position du grand EWME filaire décoratif en bas de page */
  filaire?: 'gauche' | 'droite';
  jsonLd?: Record<string, unknown>;
}

const {
  titre,
  description = site.description,
  active = null,
  variantePanneau = 'page',
  filaire: coteFilaire = 'droite',
  jsonLd,
} = Astro.props;

const titreComplet = titre === site.nom ? `${site.nom} — ${site.metier}` : `${titre} · ${site.nom}`;
const canonique = new URL(Astro.url.pathname, Astro.site);
const svgFilaire = filaire.replace(/\s(width|height)="[^"]*"/g, '').replace('<svg', '<svg aria-hidden="true" class="h-full w-full"');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      Thème : appliqué avant l'affichage pour éviter un flash.
      Clair par défaut, même si l'appareil est en mode sombre ; sombre seulement si le visiteur l'a choisi.
    -->
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('ewme-theme') === 'ewme-sombre' ? 'ewme-sombre' : 'ewme-clair';
      } catch (e) {
        document.documentElement.dataset.theme = 'ewme-clair';
      }
    </script>
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1e4d3b" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:site_name" content={site.nom} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!--
      Écran de chargement : décidé avant le premier affichage pour éviter tout flash.
      Affiché seulement à la première page de la session, et jamais si l'utilisateur
      a demandé moins d'animations. Sans stockage disponible (navigation privée stricte), pas d'écran.
    -->
    <script is:inline>
      try {
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('ewme-chargement-vu')) {
          sessionStorage.setItem('ewme-chargement-vu', '1');
          document.documentElement.setAttribute('data-chargement', '');
        }
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen">
    <EcranChargement />
    <a
      href="#contenu"
      class="sr-only z-50 rounded-lg bg-vert px-4 py-3 text-ui text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Aller au contenu
    </a>

    <div class="fond-page relative overflow-x-clip">
      <!-- Trame de papier millimétré, en parallaxe (voir le script plus bas) -->
      <div class="trame-fixe" aria-hidden="true" data-trame></div>
      <!-- Décor : halos, EWME filaire et coordonnées (purement décoratif) -->
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="halo -left-[370px] -top-[290px] size-[900px]"></div>
        <div class="halo -right-[320px] top-[80px] size-[800px]"></div>
        <div
          class:list={[
            'absolute bottom-[200px] h-[640px] w-[1405px] text-principal opacity-[0.07]',
            coteFilaire === 'gauche' ? '-left-[385px]' : 'left-[415px]',
          ]}
          set:html={svgFilaire}
        />
        <p
          class="absolute left-[54px] top-[672px] hidden origin-top-left -rotate-90 text-label text-principal opacity-30 xl:block"
          style="translate: 0 308px;"
        >
          EWME · 47.51° N — 6.80° E · Montbéliard
        </p>
      </div>

      <HeaderPanneau active={active} variante={variantePanneau}>
        <slot name="panneau" />
      </HeaderPanneau>

      <main class="relative z-10">
        <slot />
      </main>

      <Footer active={active} />
    </div>

    <script>
      // Parallaxe du fond : la trame défile à 20 % de la vitesse de la page (le contenu, lui, défile normalement).
      // Le calque de la trame est fixé à l'écran ; on le remonte de 20 % du défilement. Le motif se répète tous les
      // 192 px : on ne garde que le reste de la division, le calque n'a donc besoin que d'un motif de marge.
      // L'onglet du hero (accueil) porte la même trame : elle est calée sur l'écran comme le calque, pour rester alignée.
      // Avec « réduire les animations » : pas de parallaxe, la trame défile avec la page.
      const VITESSE_TRAME = 0.2;
      const MOTIF = 192;
      const reduit = window.matchMedia('(prefers-reduced-motion: reduce)');
      const trame = document.querySelector<HTMLElement>('[data-trame]')!;
      const fond = trame.parentElement!;
      const onglet = document.querySelector<HTMLElement>('[data-onglet-bas]');
      let enAttente = false;

      const decaler = () => {
        enAttente = false;
        if (reduit.matches) {
          trame.style.transform = '';
          if (onglet) {
            // Trame de l'onglet calée sur celle de la page (qui défile normalement)
            const o = onglet.getBoundingClientRect();
            const f = fond.getBoundingClientRect();
            onglet.style.backgroundAttachment = '';
            onglet.style.backgroundPosition = `${f.left - o.left}px ${f.top - o.top}px`;
          }
          return;
        }
        const decalage = -((window.scrollY * VITESSE_TRAME) % MOTIF);
        trame.style.transform = `translate3d(0, ${decalage}px, 0)`;
        if (onglet) {
          onglet.style.backgroundAttachment = 'fixed';
          onglet.style.backgroundPosition = `0 ${decalage}px`;
        }
      };
      window.addEventListener(
        'scroll',
        () => {
          // Au plus une mise à jour par image affichée
          if (!enAttente) {
            enAttente = true;
            requestAnimationFrame(decaler);
          }
        },
        { passive: true },
      );
      reduit.addEventListener('change', decaler);
      new ResizeObserver(decaler).observe(document.body); // mise en page qui bouge (polices, redimensionnement)
      onglet?.classList.add('trame-alignee');
      decaler();
    </script>
  </body>
</html>
