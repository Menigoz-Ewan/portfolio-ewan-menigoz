---
import '../styles/global.css';
import filaire from '../assets/svg/ewme-filaire-large.svg?raw';
import HeaderPanneau from '../components/HeaderPanneau.astro';
import Footer from '../components/Footer.astro';
import { site, type PageId } from '../data/site';

interface Props {
  titre: string;
  description?: string;
  /** Page active : place l'onglet du header (null = pas d'onglet) et marque le lien du pied de page */
  active?: PageId | null;
  /** « libre » sur l'accueil, dont le hero gère ses propres marges dans le panneau */
  variantePanneau?: 'page' | 'libre';
  /** Position du grand EWME filaire décoratif en bas de page */
  filaire?: 'gauche' | 'droite';
  jsonLd?: Record<string, unknown>;
}

const {
  titre,
  description = site.description,
  active = null,
  variantePanneau = 'page',
  filaire: coteFilaire = 'droite',
  jsonLd,
} = Astro.props;

const titreComplet = titre === site.nom ? `${site.nom} — ${site.metier}` : `${titre} · ${site.nom}`;
const canonique = new URL(Astro.url.pathname, Astro.site);
const svgFilaire = filaire.replace(/\s(width|height)="[^"]*"/g, '').replace('<svg', '<svg aria-hidden="true" class="h-full w-full"');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1e4d3b" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:site_name" content={site.nom} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen">
    <a
      href="#contenu"
      class="sr-only z-50 rounded-lg bg-vert px-4 py-3 text-ui text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Aller au contenu
    </a>

    <div class="fond-trame relative overflow-x-clip">
      <!-- Décor : halos, EWME filaire et coordonnées (purement décoratif) -->
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="halo -left-[370px] -top-[290px] size-[900px]"></div>
        <div class="halo -right-[320px] top-[80px] size-[800px]"></div>
        <div
          class:list={[
            'absolute bottom-[200px] h-[640px] w-[1405px] text-encre opacity-[0.07]',
            coteFilaire === 'gauche' ? '-left-[385px]' : 'left-[415px]',
          ]}
          set:html={svgFilaire}
        />
        <p
          class="absolute left-[54px] top-[672px] hidden origin-top-left -rotate-90 text-label text-encre opacity-30 xl:block"
          style="translate: 0 308px;"
        >
          EWME · 47.51° N — 6.80° E · Montbéliard
        </p>
      </div>

      <HeaderPanneau active={active} variante={variantePanneau}>
        <slot name="panneau" />
      </HeaderPanneau>

      <main class="relative z-10">
        <slot />
      </main>

      <Footer active={active} />
    </div>
  </body>
</html>
