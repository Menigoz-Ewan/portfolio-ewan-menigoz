---
// Page 404 personnalisée (QUALITE R7) : même charte que le reste du site, panneau sans onglet.
import Layout from '../layouts/Layout.astro';
import IntroPage from '../components/IntroPage.astro';
import Button from '../components/Button.astro';
---

<Layout titre="Page introuvable" description="Cette page n’existe pas ou a été déplacée.">
  <IntroPage slot="panneau" titre="Tu t’es égaré ! Cette page n’existe pas." chapo="Le lien est peut-être cassé, ou la page a été déplacée.">
    <div class="flex flex-wrap gap-3">
      <Button href="/" variante="light">Retour à l’accueil</Button>
      <Button href="/projets" variante="contour">Voir les projets</Button>
    </div>
  </IntroPage>
  <div class="pb-24"></div>
</Layout>
