---
// Galerie « Passage » (variante A du canvas Claude Design, recréée d'après le modèle « Passage Gallery » de React Bits Pro) :
// une boîte en 3D, ouverte sur toute la largeur de l'écran ; ses quatre parois (murs gauche et droit, sol, plafond)
// sont couvertes de visuels qui avancent vers nous en boucle, puis sortent par les bords de l'écran.
// Animation automatique : bouton pause (WCAG 2.2.2). Au survol, le visuel vient se placer droit au centre ;
// quand la souris le quitte, il retourne dans la boîte, qui repart.
// Avec « réduire les animations » : les visuels s'affichent en grille, immobiles.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import IntroPage from '../components/IntroPage.astro';

import chateau from '../assets/images/affiche-chateau.png';
import cimadeAffiche from '../assets/images/polaroid-cimade.png';
import cimadeLogo from '../assets/images/galerie/cimade-recherches-logo.png';
import exposition from '../assets/images/polaroid-exposition.png';
import theatre from '../assets/images/galerie/affiche-theatre.png';
import natureMorte from '../assets/images/galerie/nature-morte.png';
import oeuvre from '../assets/images/galerie/oeuvre-exposee.png';
import temple from '../assets/images/galerie/affiche-temple.png';

const visuels = [
  { src: chateau, categorie: 'Illustration', titre: 'Affiche touristique · 1/3', alt: 'Affiche « Au sommet de l’Histoire » : le château des ducs de Wurtemberg en aplats de couleurs' },
  { src: cimadeAffiche, categorie: 'Identité', titre: 'La Cimade — affiche', alt: 'Affiche pour La Cimade : poing levé noir entouré de cercles rouges' },
  { src: cimadeLogo, categorie: 'Identité', titre: 'La Cimade — recherches de logo', alt: 'Recherches typographiques pour le logo de La Cimade : plusieurs versions du nom et de la lettre « C »' },
  { src: exposition, categorie: 'Photographie', titre: 'Accrochage d’exposition', alt: 'Deux grandes toiles aux motifs bleu-vert accrochées dans une salle d’exposition' },
  { src: theatre, categorie: 'Illustration', titre: 'Affiche touristique · 2/3', alt: 'Affiche « Un spectacle depuis 2000 ans » : le théâtre gallo-romain de Mandeure vu du ciel' },
  { src: natureMorte, categorie: 'Photographie', titre: 'Nature morte', alt: 'Nature morte : chemise, baskets jaunes, livres et objets posés au sol' },
  { src: oeuvre, categorie: 'Photographie', titre: 'Œuvre exposée', alt: 'Tableau coloré aux formes végétales accroché à un mur blanc' },
  { src: temple, categorie: 'Illustration', titre: 'Affiche touristique · 3/3', alt: 'Affiche « L’élégance de la Renaissance » : le temple Saint-Martin et son clocher' },
];

// Les quatre parois de la boîte. Pour chacune : position de la paroi (x, y), sa rotation pour faire face
// à l'intérieur. Chaque paroi porte deux rangées (haut / bas pour les murs, gauche / droite pour le sol et le plafond).
// --demi-l / --demi-h : demi-largeur et demi-hauteur de la boîte (définies dans le CSS).
const parois = [
  { nom: 'gauche', x: 'calc(var(--demi-l) * -1)', y: (k: number) => `calc(var(--demi-h) * ${k % 2 ? 0.5 : -0.5})`, rot: 'rotateY(90deg)', type: 'mur' },
  { nom: 'droite', x: 'var(--demi-l)', y: (k: number) => `calc(var(--demi-h) * ${k % 2 ? 0.5 : -0.5})`, rot: 'rotateY(-90deg)', type: 'mur' },
  { nom: 'sol', x: '', y: () => 'var(--demi-h)', rot: 'rotateX(90deg)', type: 'sol' },
  { nom: 'plafond', x: '', y: () => 'calc(var(--demi-h) * -1)', rot: 'rotateX(-90deg)', type: 'sol' },
];
const DUREE = 24; // secondes pour traverser toute la boîte
const PAR_PAROI = 12; // tuiles par paroi (deux par anneau)
const ANNEAUX = PAR_PAROI / 2; // « anneaux » répartis à égale distance dans la profondeur
// Les tuiles d'un même anneau sont à la même profondeur sur les quatre parois : le plafond est aligné
// avec le sol, et ses tuiles touchent celles des deux murs de la même façon, à gauche comme à droite.
const tuiles = parois.flatMap((paroi, p) =>
  Array.from({ length: PAR_PAROI }, (_, k) => {
    // Sol et plafond : deux colonnes, à gauche et à droite du centre
    const x = paroi.type === 'sol' ? `calc(var(--demi-l) * ${k % 2 ? -0.45 : 0.45})` : paroi.x;
    const anneau = Math.floor(k / 2);
    return {
      paroi: paroi.nom,
      visuel: visuels[(k + p * 3) % visuels.length],
      // Seules les 8 premières tuiles du mur gauche sont lues (les 8 visuels, une fois chacun) ; le reste est décoratif
      lu: p === 0 && k < visuels.length,
      classe: paroi.type === 'mur' ? 'tuile tuile-mur' : 'tuile tuile-sol',
      style: `--x: ${x}; --y: ${paroi.y(k)}; --rot: ${paroi.rot}; --retard: ${-(anneau * DUREE) / ANNEAUX}s; --duree: ${DUREE}s`,
    };
  }),
);
// Cadres fixes qui dessinent la boîte en perspective (comme une trame)
const cadres = Array.from({ length: 7 }, (_, i) => i);
---

<Layout
  titre="Galerie"
  description="Galerie d’Ewan Menigoz : affiches, recherches d’identité visuelle et photographies."
  active="galerie"
>
  <IntroPage
    slot="panneau"
    titre="Affiches, identités et photographies."
    chapo="Les visuels qui complètent mes projets : recherches graphiques, affiches et regards photographiques."
  />

  <section aria-label="Visuels" class="pb-24 pt-8" data-passage>
    <div class="passage">
      <!-- Trame : cadres de la boîte à différentes profondeurs (décor) -->
      <div class="zone" aria-hidden="true">
        <div class="repere">
          {cadres.map((i) => <span class="cadre" style={`--z: ${-i * 450}px`} />)}
        </div>
      </div>
      <!--
        Une zone par paroi, découpée à l'écran (clip-path) en triangle depuis le centre :
        une image du plafond ne peut jamais passer devant un mur, et inversement.
      -->
      {
        parois.map((paroi) => (
          <div class:list={['zone', `zone-${paroi.nom}`]}>
            <ul class="repere tuiles">
              {tuiles
                .filter((t) => t.paroi === paroi.nom)
                .map((t) => (
                  <li class={t.classe} style={t.style} aria-hidden={t.lu ? undefined : 'true'} data-titre={t.visuel.titre} data-categorie={t.visuel.categorie}>
                    <figure class="tuile-figure">
                      <Image src={t.visuel.src} alt={t.lu ? t.visuel.alt : ''} width={532} class="tuile-image" />
                      {t.lu && <figcaption class="sr-only">{t.visuel.categorie} : {t.visuel.titre}</figcaption>}
                    </figure>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
      <!--
        Visuel agrandi : au survol d'une tuile, une copie de l'image vient se placer droite au centre ;
        quand la souris la quitte, elle retourne à la place de la tuile. Copie visuelle : cachée aux lecteurs d'écran.
      -->
      <figure class="zoom" aria-hidden="true" hidden data-zoom>
        <img class="zoom-image" src="" alt="" data-zoom-image />
        <figcaption class="zoom-legende">
          <span class="text-label" data-zoom-categorie></span>
          <span class="text-ui" data-zoom-titre></span>
        </figcaption>
      </figure>
      <button type="button" class="bouton-pause" aria-pressed="false" data-pause>
        <span data-pause-libelle>Pause</span>
      </button>
    </div>
  </section>
</Layout>

<style>
  /* La scène : toute la largeur de l'écran, en perspective ; les visuels sortent par les bords */
  .passage {
    --demi-l: 46vw;
    --demi-h: 300px;
    /* Points très lointains sur les diagonales de la boîte, pour tracer les zones des parois */
    --loin-x: calc(var(--demi-l) * 20);
    --loin-y: calc(var(--demi-h) * 20);
    position: relative;
    height: 680px;
    overflow: hidden;
  }
  /*
   * Une zone = une scène en perspective qui couvre toute la largeur, avec le même point de fuite (le centre).
   * Perspective assez lointaine : les visuels sont moins déformés sur les parois.
   */
  .zone {
    position: absolute;
    inset: 0;
    perspective: 1100px;
    perspective-origin: 50% 50%;
    pointer-events: none;
  }
  /* Zones des parois : triangles qui partent du centre et passent par les coins de la boîte */
  .zone-plafond {
    clip-path: polygon(50% 50%, calc(50% - var(--loin-x)) calc(50% - var(--loin-y)), calc(50% + var(--loin-x)) calc(50% - var(--loin-y)));
  }
  .zone-sol {
    clip-path: polygon(50% 50%, calc(50% + var(--loin-x)) calc(50% + var(--loin-y)), calc(50% - var(--loin-x)) calc(50% + var(--loin-y)));
  }
  .zone-gauche {
    clip-path: polygon(50% 50%, calc(50% - var(--loin-x)) calc(50% + var(--loin-y)), calc(50% - var(--loin-x)) calc(50% - var(--loin-y)));
  }
  .zone-droite {
    clip-path: polygon(50% 50%, calc(50% + var(--loin-x)) calc(50% - var(--loin-y)), calc(50% + var(--loin-x)) calc(50% + var(--loin-y)));
  }
  /* Repère 3D : au centre de la zone, les tuiles gardent leur position dans l'espace */
  .repere {
    position: absolute;
    left: 50%;
    top: 50%;
    transform-style: preserve-3d;
  }
  /* Cadres fixes : un rectangle de la taille de la boîte, recule à chaque profondeur */
  .cadre {
    position: absolute;
    left: calc(var(--demi-l) * -1);
    top: calc(var(--demi-h) * -1);
    width: calc(var(--demi-l) * 2);
    height: calc(var(--demi-h) * 2);
    border: 1px solid var(--color-trait);
    transform: translateZ(var(--z));
    pointer-events: none;
  }
  /*
   * Une tuile : placée sur sa paroi (x, y), tournée pour faire face à l'intérieur (--rot),
   * puis déplacée du fond de la boîte (z = -3200 px) jusque derrière nous (z = +700 px).
   * translate(-50%, -50%) en dernier : la tuile est centrée sur son point d'accroche.
   */
  .tuile {
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: auto; /* les zones laissent passer la souris, pas les tuiles */
    animation: avance var(--duree) linear infinite;
    animation-delay: var(--retard);
  }
  /* Tuiles presque carrées (proches des visuels) : moins d'étirement et de recadrage qu'en format allongé */
  .tuile-mur {
    width: 250px;
    height: 270px;
  }
  .tuile-sol {
    width: 290px;
    height: 250px;
  }
  @keyframes avance {
    from {
      transform: translate3d(var(--x), var(--y), -3400px) var(--rot) translate(-50%, -50%);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    to {
      transform: translate3d(var(--x), var(--y), 900px) var(--rot) translate(-50%, -50%);
      opacity: 1;
    }
  }
  .tuile-figure {
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: 0 16px 32px rgb(0 0 0 / 0.18);
    cursor: zoom-in;
  }
  .tuile-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Tuile dont la copie est au centre : invisible le temps de l'agrandissement */
  .tuile.en-avant {
    visibility: hidden;
  }
  /* Pause : avec le bouton, ou le temps qu'un visuel est agrandi au centre */
  .passage.en-pause .tuile,
  .passage.en-zoom .tuile {
    animation-play-state: paused;
  }
  /* Visuel agrandi, droit, au centre de la scène, en entier (sans recadrage) */
  .zoom {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 4;
    translate: -50% -50%;
    display: flex;
    flex-direction: column;
    width: min(420px, 80vw);
    margin: 0;
    border-radius: 16px;
    overflow: hidden;
    background: var(--color-carte);
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.3);
    transform-origin: 0 0;
  }
  .zoom[hidden] {
    display: none;
  }
  .zoom-image {
    display: block;
    width: 100%;
    max-height: 480px;
    object-fit: contain;
    background: var(--color-surface);
  }
  .zoom-legende {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px 14px;
    color: var(--color-principal);
  }
  .zoom-legende .text-label {
    color: var(--color-vert-texte);
  }
  .bouton-pause {
    position: absolute;
    left: 50%;
    bottom: 16px;
    translate: -50% 0;
    z-index: 3;
    height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--color-trait-fort);
    background: var(--color-carte);
    color: var(--color-principal);
    transition: background-color var(--duree-bouton);
  }
  .bouton-pause:hover {
    background: var(--color-surface);
  }
  .bouton-pause:focus-visible {
    outline: 2.5px solid var(--color-vert-texte);
    outline-offset: 2px;
  }
  /* Petits écrans : boîte et tuiles plus petites */
  @media (max-width: 767px) {
    .passage {
      --demi-h: 200px;
      height: 480px;
    }
    .tuile-mur {
      width: 170px;
      height: 190px;
    }
    .tuile-sol {
      width: 200px;
      height: 170px;
    }
  }
  /* Réduire les animations : grille immobile des 8 visuels, sans boîte */
  @media (prefers-reduced-motion: reduce) {
    .passage {
      height: auto;
      overflow: visible;
      padding: 0 20px;
    }
    /* Seule la zone du mur gauche (les 8 visuels, une fois chacun) reste, à plat */
    .zone {
      display: none;
    }
    .zone-gauche {
      display: block;
      position: static;
      perspective: none;
      clip-path: none;
      pointer-events: auto;
    }
    .repere {
      position: static;
    }
    /* Les répétitions du mur gauche (décoratives) sont masquées */
    .zone-gauche .tuile[aria-hidden='true'] {
      display: none;
    }
    .bouton-pause {
      display: none;
    }
    .tuiles {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 20px;
    }
    .tuile {
      position: static;
      width: auto;
      height: auto;
      animation: none;
    }
    .tuile-image {
      aspect-ratio: 4 / 5;
    }
  }
</style>

<script>
  // Bouton pause / lecture de la boîte
  for (const bloc of document.querySelectorAll<HTMLElement>('[data-passage]')) {
    const passage = bloc.querySelector<HTMLElement>('.passage')!;
    const bouton = bloc.querySelector<HTMLButtonElement>('[data-pause]')!;
    const libelle = bouton.querySelector<HTMLElement>('[data-pause-libelle]')!;
    bouton.addEventListener('click', () => {
      const pause = passage.classList.toggle('en-pause');
      bouton.setAttribute('aria-pressed', String(pause));
      libelle.textContent = pause ? 'Lecture' : 'Pause';
    });

    // ── Visuel agrandi au centre ──────────────────────────────────────
    const zoom = bloc.querySelector<HTMLElement>('[data-zoom]')!;
    const zoomImage = bloc.querySelector<HTMLImageElement>('[data-zoom-image]')!;
    const zoomTitre = bloc.querySelector<HTMLElement>('[data-zoom-titre]')!;
    const zoomCategorie = bloc.querySelector<HTMLElement>('[data-zoom-categorie]')!;
    const reduit = window.matchMedia('(prefers-reduced-motion: reduce)');
    let courante: HTMLElement | null = null; // tuile dont la copie est au centre
    let survolee = false; // la souris est-elle déjà passée sur le visuel agrandi ?
    let enMouvement = false;

    // Décalage et échelle qui superposent le visuel agrandi à la tuile (technique « FLIP »)
    const versTuile = (tuile: HTMLElement) => {
      const t = tuile.getBoundingClientRect();
      const z = zoom.getBoundingClientRect();
      return `translate(${t.left - z.left}px, ${t.top - z.top}px) scale(${t.width / z.width}, ${t.height / z.height})`;
    };

    const ouvrir = (tuile: HTMLElement) => {
      if (courante || enMouvement) return;
      courante = tuile;
      survolee = false;
      const image = tuile.querySelector('img')!;
      zoomImage.src = image.currentSrc || image.src;
      zoomTitre.textContent = tuile.dataset.titre ?? '';
      zoomCategorie.textContent = tuile.dataset.categorie ?? '';
      passage.classList.add('en-zoom'); // la boîte s'arrête : la tuile ne bouge plus pendant l'agrandissement
      zoom.hidden = false;
      tuile.classList.add('en-avant');
      if (reduit.matches) return;
      // Le visuel part de la place de la tuile et vient se poser droit au centre
      enMouvement = true;
      zoom.animate([{ transform: versTuile(tuile), opacity: 0.6 }, { transform: 'none', opacity: 1 }], {
        duration: 550,
        easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      }).finished.finally(() => (enMouvement = false));
    };

    const fermer = () => {
      const tuile = courante;
      if (!tuile || enMouvement) return;
      const fin = () => {
        zoom.hidden = true;
        tuile.classList.remove('en-avant');
        passage.classList.remove('en-zoom');
        courante = null;
      };
      if (reduit.matches) return fin();
      // Retour du visuel à la place de sa tuile, puis la boîte repart
      enMouvement = true;
      zoom.animate([{ transform: 'none', opacity: 1 }, { transform: versTuile(tuile), opacity: 0.6 }], {
        duration: 450,
        easing: 'cubic-bezier(0.65, 0, 0.35, 1)',
      }).finished.finally(() => {
        enMouvement = false;
        fin();
      });
    };

    for (const tuile of bloc.querySelectorAll<HTMLElement>('.tuile')) {
      tuile.addEventListener('mouseenter', () => ouvrir(tuile));
      tuile.addEventListener('click', () => ouvrir(tuile)); // écrans tactiles
    }
    // On le quitte (après l'avoir survolé), on sort de la scène, ou on touche à côté : il repart dans la boîte
    zoom.addEventListener('mouseenter', () => (survolee = true));
    zoom.addEventListener('mouseleave', () => survolee && fermer());
    passage.addEventListener('mouseleave', fermer);
    passage.addEventListener('click', (e) => {
      const cible = e.target as HTMLElement;
      if (courante && !zoom.contains(cible) && !cible.closest('.tuile')) fermer();
    });
  }
</script>
