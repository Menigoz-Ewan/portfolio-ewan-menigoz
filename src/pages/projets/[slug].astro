---
// Étude de cas générée pour chaque projet qui possède un contenu « etude » (src/data/projets.ts).
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { projets, projetsAvecEtude, type Projet } from '../../data/projets';

export function getStaticPaths() {
  return projetsAvecEtude.map((projet) => ({ params: { slug: projet.slug }, props: { projet } }));
}

interface Props {
  projet: Projet;
}

const { projet } = Astro.props;
const etude = projet.etude!;
const suivant = projets.find((p) => p.slug === etude.suivant);

const fiche = [
  { libelle: 'Rôle', valeur: etude.fiche.role },
  { libelle: 'Contexte', valeur: etude.fiche.contexte },
  { libelle: 'Outils', valeur: etude.fiche.outils },
  { libelle: 'Livrables', valeur: etude.fiche.livrables },
];
---

<Layout titre={projet.titre} description={etude.accroche} active="projets" variantePanneau="libre" filaire="droite">
  <!-- Contenu du panneau vert : fil d'Ariane, en-tête du projet et fiche -->
  <div slot="panneau" class="px-6 pb-10 pt-8 lg:px-24 lg:pb-14">
    <nav aria-label="Fil d’Ariane">
      <ol class="flex gap-2 text-ui text-creme/70">
        <li><a href="/projets" class="rounded transition-colors hover:text-creme focus-visible:outline-creme">Projets</a></li>
        <li aria-hidden="true">/</li>
        <li><span aria-current="page" class="text-creme">{projet.titre}</span></li>
      </ol>
    </nav>

    <div class="flex flex-col gap-8 pt-6 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex max-w-[690px] flex-col gap-5">
        <ul class="flex flex-wrap gap-2">
          {etude.etiquettes.map((e) => <li class="rounded border border-creme/40 bg-creme/14 px-2 py-1 text-label text-creme">{e}</li>)}
        </ul>
        <h1 class="text-display text-creme">{projet.titre}</h1>
        <p class="text-lead text-creme/80">{etude.accroche}</p>
      </div>
    <aside aria-labelledby="fiche-projet" class="w-full shrink-0 rounded-2xl border border-sable-fonce bg-white px-6 pb-2 pt-5 lg:w-[384px]">
      <h2 id="fiche-projet" class="text-label text-vert">Fiche projet</h2>
      <dl>
        {
          fiche.map((f, i) => (
            <div class:list={['flex flex-col gap-1 py-3', i < fiche.length - 1 && 'border-b border-sable-fonce']}>
              <dt class="text-label text-texte-secondaire">{f.libelle}</dt>
              <dd class="text-ui text-encre">{f.valeur}</dd>
            </div>
          ))
        }
      </dl>
      </aside>
    </div>
  </div>

  <!-- Visuel principal : image unique ou triptyque -->
  <div class="conteneur pb-24">
    {
      etude.visuelPrincipal.length === 1 ? (
        <Image
          src={etude.visuelPrincipal[0].src}
          alt={etude.visuelPrincipal[0].alt}
          width={2400}
          class="h-[240px] w-full rounded-[20px] bg-white object-cover md:h-[560px]"
          loading="eager"
        />
      ) : (
        <ul class="grid gap-6 rounded-[20px] border border-sable-fonce bg-white p-4 sm:grid-cols-3 md:p-8">
          {etude.visuelPrincipal.map((v, i) => (
            <li>
              <Image src={v.src} alt={v.alt} width={720} class="h-[420px] w-full rounded-[10px] object-cover md:h-[490px]" loading={i === 0 ? 'eager' : 'lazy'} />
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <!-- Contexte -->
  <section aria-labelledby="titre-contexte" class="conteneur flex flex-col gap-6 pb-24 lg:flex-row">
    <div class="flex flex-col gap-3 lg:w-[384px] lg:shrink-0">
      <p class="text-label text-vert">Contexte</p>
      <h2 id="titre-contexte" class="text-h2">{etude.contexte.titre}</h2>
    </div>
    <div class="flex flex-1 flex-col gap-6">
      <p class="max-w-[690px] text-lead text-texte-secondaire">{etude.contexte.texte}</p>
      <ul class="flex flex-wrap gap-2" aria-label="Contraintes du projet">
        {
          etude.contexte.contraintes.map((c) => (
            <li class="flex items-center gap-2 rounded-full border border-bordure bg-sable px-3.5 py-2 text-ui">
              <span aria-hidden="true" class="size-1.5 rounded-full bg-vert" />
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Défi -->
  <section aria-labelledby="titre-defi" class="conteneur flex flex-col gap-6 pb-24">
    <div class="flex flex-col gap-4 rounded-[20px] bg-vert p-8 text-white md:p-14">
      <p class="text-label">Le défi</p>
      <h2 id="titre-defi" class="max-w-[900px] text-h1">{etude.defi.enonce}</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {
        etude.defi.visuels.map((v) => (
          <Image
            src={v.src}
            alt={v.alt}
            width={1200}
            class:list={[
              'h-[260px] w-full rounded-2xl md:h-[420px]',
              etude.defi.fondLavande ? 'bg-lavande object-contain' : 'bg-white object-cover',
            ]}
          />
        ))
      }
    </div>
  </section>

  <!-- Solution -->
  <section aria-labelledby="titre-solution" class="conteneur flex flex-col gap-8 pb-24 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex flex-col gap-4 lg:w-[486px]">
      <p class="text-label text-vert">La solution</p>
      <h2 id="titre-solution" class="text-h2">{etude.solution.titre}</h2>
      <p class="text-body text-texte-secondaire">{etude.solution.texte}</p>
    </div>
    <Image
      src={etude.solution.visuel.src}
      alt={etude.solution.visuel.alt}
      width={1380}
      class="h-[300px] w-full rounded-[20px] bg-white object-cover md:h-[460px] lg:w-[690px]"
    />
  </section>

  <!-- Bilan -->
  <section aria-labelledby="titre-bilan" class="conteneur flex flex-col gap-7 pb-24">
    <div class="flex flex-col gap-3">
      <p class="text-label text-vert">Bilan</p>
      <h2 id="titre-bilan" class="text-h2">Ce que j’en retiens</h2>
    </div>
    <ol class="grid gap-6 md:grid-cols-3">
      {
        etude.bilan.map((point, i) => (
          <li class="flex flex-col gap-3.5 rounded-2xl border border-sable-fonce bg-white px-6 pb-7 pt-6">
            <span class="self-start rounded bg-vert px-2 py-1 text-label text-white">{String(i + 1).padStart(2, '0')}</span>
            <p class="text-body text-encre">{point}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Projet suivant -->
  {
    suivant && (
      <div class="conteneur pb-24">
        <a
          href={`/projets/${suivant.slug}`}
          class="group flex flex-col gap-6 rounded-[20px] border border-sable-fonce bg-white p-4 transition-[border-color,box-shadow] duration-(--duree-carte) ease-(--ease-sortie) hover:border-vert hover:shadow-[0_14px_28px_rgb(23_23_23/0.08)] sm:flex-row sm:items-center sm:pr-8"
        >
          <Image src={suivant.vignette.src} alt="" width={440} height={276} class="h-[138px] w-full rounded-xl object-cover sm:w-[220px]" />
          <span class="flex flex-1 flex-col gap-2">
            <span class="text-label text-texte-secondaire">Projet suivant</span>
            <span class="text-h2 text-encre">{suivant.titre}</span>
          </span>
          <!-- Apparence du bouton Primary, sans élément interactif imbriqué dans le lien -->
          <span class="inline-flex items-center gap-2 self-start rounded-lg bg-rouge px-5 py-3 text-button text-white shadow-[0_4px_12px_rgb(206_26_27/0.25)] transition-colors duration-(--duree-bouton) group-hover:bg-rouge-fonce sm:self-auto">
            Voir le projet
            <span class="inline-flex transition-transform duration-(--duree-bouton) group-hover:translate-x-1">
              <Icon nom="arrow-right" />
            </span>
          </span>
        </a>
      </div>
    )
  }
</Layout>
