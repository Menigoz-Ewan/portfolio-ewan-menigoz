---
// Une étude de cas en français par projet : le contenu est dans src/vues/EtudeDeCas.astro.
import EtudeDeCas from '../../vues/EtudeDeCas.astro';
import { projetsAvecEtude } from '../../data/projets';

export function getStaticPaths() {
  return projetsAvecEtude.map((projet) => ({ params: { slug: projet.slug } }));
}
---

<EtudeDeCas slug={Astro.params.slug} />
