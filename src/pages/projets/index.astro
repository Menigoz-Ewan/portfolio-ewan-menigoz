---
import Layout from '../../layouts/Layout.astro';
import IntroPage from '../../components/IntroPage.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Button from '../../components/Button.astro';
import { projets, categories, lienProjet, type Categorie } from '../../data/projets';

const compte = (id: string) => (id === 'tous' ? projets.length : projets.filter((p) => p.categories.includes(id as Categorie)).length);
---

<Layout
  titre="Projets"
  description="Cas d’étude d’Ewan Menigoz : web app, data-visualisation, affiches et identité visuelle. Chaque projet part d’un besoin concret."
  active="projets"
  filaire="gauche"
>
  <IntroPage
    slot="panneau"
    titre="Des problèmes, mes solutions."
    chapo="Apprendre la LSF, rendre des données lisibles, valoriser un patrimoine, refondre une identité : chaque projet part d’un besoin concret et aboutit à un livrable — web app, data-visualisation, affiches ou charte."
  />

  <!-- Filtres : sous le panneau, sur le fond crème -->
  <section aria-label="Filtres" class="conteneur py-8">
    <div role="group" aria-label="Filtrer les projets" class="flex flex-wrap gap-2" data-filtres>
      {
        categories.map((c) => (
          <button
            type="button"
            aria-pressed={c.id === 'tous' ? 'true' : 'false'}
            data-filtre={c.id}
            class="filtre flex items-center gap-2 rounded-full border py-2.5 pl-4 pr-3.5 transition-colors duration-(--duree-bouton) ease-(--ease-sortie)"
          >
            <span class="text-ui">{c.libelle}</span>
            <span class="font-mono text-[11px] font-medium">{compte(c.id)}</span>
          </button>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="titre-liste" class="conteneur pb-24">
    <!-- Titre invisible : garde l'ordre des titres h1 → h2 → h3 (QUALITE A12) -->
    <h2 id="titre-liste" class="sr-only">Liste des projets</h2>
    <p class="sr-only" aria-live="polite" data-filtres-annonce></p>
    <ul class="grid gap-9 md:grid-cols-2 lg:grid-cols-3">
      {
        projets.map((p) => (
          <li data-categories={p.categories.join(' ')}>
            <ProjectCard titre={p.titre} etiquette={p.etiquette} resume={p.resume} vignette={p.vignette} href={lienProjet(p)} class="h-full" />
          </li>
        ))
      }
      <!-- Toute la largeur de la grille : passe toujours sur sa propre ligne, sous les projets -->
      <li class="md:col-span-2 lg:col-span-3" data-cta>
        <div class="flex h-full flex-col justify-center gap-8 rounded-2xl bg-vert p-8 md:min-h-[356px] md:flex-row lg:min-h-[396px] md:items-center md:justify-between md:px-12">
          <div class="flex max-w-[420px] flex-col gap-3 text-white">
            <h2 class="text-h1">Et si le prochain était le vôtre ?</h2>
            <p class="text-body">Je cherche un stage en design UI/UX ou en front-end.</p>
          </div>
          <Button href="/contact" variante="light" class="self-start md:self-auto">Proposer un stage</Button>
        </div>
      </li>
    </ul>
  </section>
</Layout>

<style>
  /* États du composant « Filtre » : Default, Hover, Actif */
  .filtre {
    background: #fff;
    border-color: var(--color-bordure);
    color: rgb(22 22 22 / 0.8);
  }
  .filtre span:last-child {
    color: var(--color-texte-secondaire);
  }
  .filtre:hover {
    background: var(--color-sable);
    border-color: rgb(22 22 22 / 0.35);
    color: var(--color-encre);
  }
  .filtre[aria-pressed='true'] {
    background: var(--color-vert);
    border-color: var(--color-vert);
    color: #fff;
  }
  .filtre[aria-pressed='true'] span:last-child {
    color: rgb(255 255 255 / 0.7);
  }
</style>

<script>
  // Filtrage côté client : masque les projets d'une autre catégorie et annonce le résultat.
  const boutons = document.querySelectorAll<HTMLButtonElement>('[data-filtre]');
  const projets = document.querySelectorAll<HTMLElement>('[data-categories]');
  const annonce = document.querySelector<HTMLElement>('[data-filtres-annonce]');

  for (const bouton of boutons) {
    bouton.addEventListener('click', () => {
      const filtre = bouton.dataset.filtre;
      for (const b of boutons) b.setAttribute('aria-pressed', String(b === bouton));
      let visibles = 0;
      for (const p of projets) {
        const visible = filtre === 'tous' || (p.dataset.categories ?? '').split(' ').includes(filtre ?? '');
        p.hidden = !visible;
        if (visible) visibles++;
      }
      if (annonce) annonce.textContent = `${visibles} projet${visibles > 1 ? 's' : ''} affiché${visibles > 1 ? 's' : ''}`;
    });
  }
</script>
