---
// Galerie (commune aux deux langues : src/pages/galerie.astro et src/pages/en/gallery.astro) — « champ infini » (recréée d'après « Infinite Gallery » de React Bits Pro, sans bibliothèque 3D) :
// les visuels flottent, petits et lointains, dans un espace en 3D qu'on traverse. Molette ou glisser vertical :
// on avance ou on recule ; glisser horizontal : on se décale ; la souris fait légèrement dériver le champ.
// Un clic sur n'importe quel visuel, même très loin, nous en approche : il vient au centre, en grand, et les autres
// restent autour, plus petits. Un seul exemplaire de chaque visuel : quand il passe derrière nous, il repart au fond.
// Rien ne bouge tout seul : pas besoin de bouton pause. Avec « réduire les animations » : grille immobile.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import IntroPage from '../components/IntroPage.astro';
import { langue } from '../i18n';

import chateau from '../assets/images/affiche-chateau.png';
import cimadeAffiche from '../assets/images/iris-cimade.png';
import cimadeLogo from '../assets/images/galerie/cimade-recherches-logo.png';
import exposition from '../assets/images/polaroid-exposition.png';
import theatre from '../assets/images/galerie/affiche-theatre.png';
import natureMorte from '../assets/images/galerie/nature-morte.png';
import oeuvre from '../assets/images/galerie/oeuvre-exposee.png';
import temple from '../assets/images/galerie/affiche-temple.png';
import auTravail from '../assets/images/galerie/au-travail.png';
import afficheFcsm from '../assets/images/galerie/affiche-fcsm.png';
import surLePont from '../assets/images/galerie/sur-le-pont.png';
import maillotRose from '../assets/images/galerie/maillot-rose.png';
import graffiti from '../assets/images/galerie/graffiti-expose.png';
import dessinBlueLock from '../assets/images/galerie/dessin-blue-lock.png';
import dessinJujutsu from '../assets/images/galerie/dessin-jujutsu-kaisen.png';
import dessinChainsaw from '../assets/images/galerie/dessin-chainsaw-man.png';
import dessinDemonSlayer from '../assets/images/galerie/dessin-demon-slayer.png';
import paysage from '../assets/images/galerie/paysage.png';
import portraitFisheye from '../assets/images/galerie/portrait-fisheye.png';

const lang = langue(Astro.currentLocale);
const T = {
  fr: {
    titre: 'Galerie',
    description: 'Galerie d’Ewan Menigoz : affiches, recherches d’identité visuelle, dessins et photographies.',
    accroche: 'Affiches, dessins et photographies.',
    chapo: 'Les visuels qui complètent mes projets : recherches graphiques, affiches, dessins à l’encre et regards photographiques.',
    visuels: 'Visuels',
    consigne: 'Faites défiler ou glissez pour avancer dans la galerie, cliquez sur un visuel pour vous en approcher.',
  },
  en: {
    titre: 'Gallery',
    description: 'Gallery by Ewan Menigoz: posters, visual identity research, drawings and photographs.',
    accroche: 'Posters, drawings and photographs.',
    chapo: 'The visuals that complete my projects: graphic research, posters, ink drawings and photographs.',
    visuels: 'Visuals',
    consigne: 'Scroll or drag to move through the gallery, click a visual to get closer.',
  },
}[lang];
// Catégorie, titre et texte alternatif en anglais, dans le même ordre que la liste des visuels
const en = [
  ['Illustration', 'Tourism poster · 1/3', 'Poster “Au sommet de l’Histoire” (At the top of History): the castle of the Dukes of Württemberg in flat colours'],
  ['Identity', 'La Cimade — poster', 'Poster for La Cimade: a black raised fist surrounded by red circles'],
  ['Identity', 'La Cimade — logo research', 'Typographic research for the La Cimade logo: several versions of the name and of the letter “C”'],
  ['Photography', 'Exhibition hanging', 'Two large paintings with blue-green patterns hanging in an exhibition room'],
  ['Illustration', 'Tourism poster · 2/3', 'Poster “Un spectacle depuis 2000 ans” (A show for 2,000 years): the Gallo-Roman theatre of Mandeure seen from above'],
  ['Photography', 'Still life', 'Still life: a shirt, yellow sneakers, books and objects on the floor'],
  ['Photography', 'Artwork on display', 'Colourful painting with plant shapes hanging on a white wall'],
  ['Illustration', 'Tourism poster · 3/3', 'Poster “L’élégance de la Renaissance” (The elegance of the Renaissance): Saint-Martin church and its bell tower'],
  ['Photography', 'At work', 'Me from behind, working on a laptop in a room lit in orange'],
  ['Poster', 'FCSM poster · Mathieu Peybernes', 'FC Sochaux-Montbéliard poster for defender number 14 Mathieu Peybernes, 2026-2027 season: two photos of the player on a blue stadium background'],
  ['Drawing', 'Fan art · Blue Lock', 'Ink drawing: football players celebrating an equaliser, score 2-2, speech bubble “Le Manshine City est à égalité !!!”'],
  ['Photography', 'On the bridge', 'Me on a bridge above a canal, in a brown T-shirt and grey shorts, in front of yellow houses'],
  ['Photography', 'Landscape', 'Two white cows grazing in a meadow, wooded hills and a blue sky behind'],
  ['Drawing', 'Fan art · Jujutsu Kaisen', 'Ink drawing: an injured character with spiky hair and a black jacket, speech bubble “I’m you.”'],
  ['Photography', 'Graffiti on display', 'Framed graffiti sketches and handwritten pages hanging in an exhibition, artwork by another artist'],
  ['Photography', 'Pink jersey', 'Close-up of me walking in a pink swirl-patterned football jersey and grey shorts'],
  ['Drawing', 'Fan art · Chainsaw Man', 'Ink drawing: a character with a topknot and a sword on his back making a hand sign, speech bubble “Kon.”'],
  ['Photography', 'Fisheye portrait', 'Fisheye portrait of me in a light grey jumper and tie, in front of a stone wall'],
  ['Drawing', 'Fan art · Demon Slayer', 'Ink drawing: a character with a cracked face and a checked jacket, speech bubble “Tu es atrocement laid.”'],
];

// x, y : place du visuel dans le champ, en fraction de la demi-largeur et de la demi-hauteur de la scène
const visuels = [
  { src: chateau, x: -0.6, y: -0.4, categorie: 'Illustration', titre: 'Affiche touristique · 1/3', alt: 'Affiche « Au sommet de l’Histoire » : le château des ducs de Wurtemberg en aplats de couleurs' },
  { src: cimadeAffiche, x: 0.5, y: 0.25, categorie: 'Identité', titre: 'La Cimade — affiche', alt: 'Affiche pour La Cimade : poing levé noir entouré de cercles rouges' },
  { src: cimadeLogo, x: -0.2, y: 0.45, categorie: 'Identité', titre: 'La Cimade — recherches de logo', alt: 'Recherches typographiques pour le logo de La Cimade : plusieurs versions du nom et de la lettre « C »' },
  { src: exposition, x: 0.6, y: -0.4, categorie: 'Photographie', titre: 'Accrochage d’exposition', alt: 'Deux grandes toiles aux motifs bleu-vert accrochées dans une salle d’exposition' },
  { src: theatre, x: -0.75, y: 0.4, categorie: 'Illustration', titre: 'Affiche touristique · 2/3', alt: 'Affiche « Un spectacle depuis 2000 ans » : le théâtre gallo-romain de Mandeure vu du ciel' },
  { src: natureMorte, x: 0.2, y: -0.45, categorie: 'Photographie', titre: 'Nature morte', alt: 'Nature morte : chemise, baskets jaunes, livres et objets posés au sol' },
  { src: oeuvre, x: 0.35, y: 0.5, categorie: 'Photographie', titre: 'Œuvre exposée', alt: 'Tableau coloré aux formes végétales accroché à un mur blanc' },
  { src: temple, x: -0.05, y: -0.3, categorie: 'Illustration', titre: 'Affiche touristique · 3/3', alt: 'Affiche « L’élégance de la Renaissance » : le temple Saint-Martin et son clocher' },
  { src: auTravail, x: 0.7, y: 0.1, categorie: 'Photographie', titre: 'Au travail', alt: 'Moi de dos, en train de travailler sur un ordinateur portable dans une pièce éclairée en orange' },
  { src: afficheFcsm, x: -0.55, y: 0.05, categorie: 'Affiche', titre: 'Affiche FCSM · Mathieu Peybernes', alt: 'Affiche du FC Sochaux-Montbéliard pour le défenseur n° 14 Mathieu Peybernes, saison 2026-2027 : deux photos du joueur sur fond de stade bleu' },
  { src: dessinBlueLock, x: 0.15, y: 0.5, categorie: 'Dessin', titre: 'Fan art · Blue Lock', alt: 'Dessin à l’encre : des footballeurs fêtent l’égalisation, score 2-2, bulle « Le Manshine City est à égalité !!! »' },
  { src: surLePont, x: -0.3, y: -0.45, categorie: 'Photographie', titre: 'Sur le pont', alt: 'Moi sur un pont au-dessus d’un canal, en t-shirt marron et short gris, devant des maisons jaunes' },
  { src: paysage, x: 0.45, y: -0.35, categorie: 'Photographie', titre: 'Paysage', alt: 'Deux vaches blanches broutent dans un pré, collines boisées et ciel bleu en arrière-plan' },
  { src: dessinJujutsu, x: -0.7, y: -0.1, categorie: 'Dessin', titre: 'Fan art · Jujutsu Kaisen', alt: 'Dessin à l’encre : un personnage blessé aux cheveux en pics et à la veste noire, bulle « I’m you. »' },
  { src: graffiti, x: 0.6, y: 0.45, categorie: 'Photographie', titre: 'Graffiti en exposition', alt: 'Esquisses de graffiti et pages manuscrites encadrées dans une exposition, œuvre d’un autre artiste' },
  { src: maillotRose, x: -0.15, y: 0.35, categorie: 'Photographie', titre: 'Maillot rose', alt: 'Moi en marche, en maillot de football rose aux motifs ondulés et short gris, vu de près' },
  { src: dessinChainsaw, x: 0.3, y: -0.5, categorie: 'Dessin', titre: 'Fan art · Chainsaw Man', alt: 'Dessin à l’encre : un personnage au chignon, sabre dans le dos, fait un signe des mains, bulle « Kon. »' },
  { src: portraitFisheye, x: -0.45, y: 0.45, categorie: 'Photographie', titre: 'Portrait au fisheye', alt: 'Portrait de moi au fisheye, pull gris clair et cravate, devant un mur de pierres' },
  { src: dessinDemonSlayer, x: 0.75, y: -0.2, categorie: 'Dessin', titre: 'Fan art · Demon Slayer', alt: 'Dessin à l’encre : un personnage au visage fissuré et à la veste à damier, bulle « Tu es atrocement laid. »' },
].map((v, i) => (lang === 'en' ? { ...v, categorie: en[i][0], titre: en[i][1], alt: en[i][2] } : v));
---

<Layout
  titre={T.titre}
  description={T.description}
  active="galerie"
>
  <IntroPage
    slot="panneau"
    titre={T.accroche}
    chapo={T.chapo}
  />

  <section aria-label={T.visuels} class="pb-24 pt-8" data-galerie>
    <p class="consigne text-small text-secondaire" id="consigne-galerie">
      {T.consigne}
    </p>
    <div class="champ" data-champ>
      <ul class="visuels" aria-describedby="consigne-galerie">
        {
          visuels.map((v, i) => (
            <li class="visuel" data-index={i} data-x={v.x} data-y={v.y}>
              <button type="button" class="visuel-bouton" aria-pressed="false" data-titre={v.titre} data-categorie={v.categorie}>
                <Image src={v.src} alt={v.alt} width={800} widths={[432, 800]} sizes="(max-width: 767px) 216px, 400px" class="visuel-image" draggable="false" loading="eager" />
                <span class="sr-only">
                  {v.categorie} : {v.titre}
                </span>
              </button>
            </li>
          ))
        }
      </ul>
      <!-- Légende du visuel dont on s'est approché -->
      <p class="legende" aria-live="polite" data-legende>
        <span class="text-label" data-legende-categorie></span>
        <span class="text-ui" data-legende-titre></span>
      </p>
    </div>
  </section>
</Layout>

<style>
  .consigne {
    margin: 0 auto 12px;
    padding: 0 20px;
    text-align: center;
  }
  /* La scène : toute la largeur, en perspective, sans fond (les visuels flottent sur la page) */
  .champ {
    position: relative;
    height: 680px;
    overflow: hidden;
    perspective: 800px;
    perspective-origin: 50% 50%;
    cursor: grab;
    touch-action: none; /* le glisser déplace le champ au lieu de faire défiler la page */
    user-select: none;
  }
  .champ.en-glisse {
    cursor: grabbing;
  }
  /* La liste transmet la 3D à ses visuels (sinon la perspective de la scène ne s'applique pas à eux) */
  .visuels {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    pointer-events: none; /* la liste ne doit pas capter les clics destinés aux visuels lointains */
  }
  /*
   * Chaque visuel est placé par le script (translate3d) depuis le centre de la scène.
   * Netteté : il est dessiné en grand (400 px) puis réduit (--echelle) ; le navigateur affiche ainsi
   * une image nette quand on s'en approche, au lieu d'agrandir une petite image (pixellisée).
   */
  .visuel {
    --echelle: 0.325; /* 400 px × 0,325 = 130 px au repos */
    position: absolute;
    left: 50%;
    top: 50%;
    width: 400px;
  }
  .visuel-bouton {
    display: block;
    width: 100%;
    padding: 0;
    border-radius: 24px; /* environ 8 px une fois réduit */
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: 0 10px 24px rgb(0 0 0 / 0.14);
    cursor: pointer;
  }
  .visuel-bouton:focus-visible {
    outline: 2.5px solid var(--color-vert-texte);
    outline-offset: 3px;
  }
  .visuel-image {
    display: block;
    width: 100%;
    height: auto; /* proportions d'origine : rien n'est étiré ni recadré */
    pointer-events: none;
  }
  /* Légende du visuel choisi, en bas de la scène */
  .legende {
    position: absolute;
    left: 50%;
    bottom: 16px;
    z-index: 5000;
    translate: -50% 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 8px 16px;
    border-radius: 12px;
    background: var(--color-carte);
    color: var(--color-principal);
    box-shadow: 0 8px 20px rgb(0 0 0 / 0.12);
    text-align: center;
    pointer-events: none;
    transition: opacity 300ms ease;
  }
  .legende .text-label {
    color: var(--color-vert-texte);
  }
  .legende:empty,
  .legende.cachee {
    opacity: 0;
  }
  @media (max-width: 767px) {
    .champ {
      height: 540px;
    }
    .visuel {
      width: 216px; /* 70 px au repos */
    }
  }
  /* Réduire les animations : grille immobile des 8 visuels */
  @media (prefers-reduced-motion: reduce) {
    .consigne,
    .legende {
      display: none;
    }
    .champ {
      height: auto;
      overflow: visible;
      perspective: none;
      padding: 0 20px;
      cursor: auto;
      touch-action: auto;
    }
    .visuels {
      position: static;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      align-items: start;
      gap: 20px;
    }
    .visuel {
      position: static;
      width: auto;
      --echelle: 1;
      transform: none !important;
      opacity: 1 !important;
    }
    .visuel-bouton {
      cursor: auto;
    }
  }
</style>

<script>
  const ECART = 400; // distance en profondeur entre deux visuels (px)
  // Longueur de la boucle en profondeur : elle grandit avec le nombre de visuels, l'écart reste le même
  const PROFONDEUR = Math.max(3200, document.querySelectorAll('[data-galerie] .visuel').length * ECART);
  const DECALAGE = 600; // un visuel « juste devant nous » est à cette profondeur (perspective : 800 px)
  const PRES = 130; // distance où l'on s'arrête devant un visuel choisi : il apparaît environ 2,4 fois plus grand
const RECUL = 300; // les autres visuels s'effacent quand ils approchent à moins de cette distance : ils restent petits
  const DERIVE = 30; // décalage maximal (px) quand la souris bouge sur la scène

  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)');
  // Reste positif d'une division (la caméra peut avancer ou reculer sans fin)
  const modulo = (a: number, b: number) => ((a % b) + b) % b;
  const borne = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));
  // Plus un visuel est loin, plus il est écarté du centre : le fond du champ ne se resserre pas en un point
  const etalement = (devant: number) => 0.75 * (1 + devant / 1200);

  for (const bloc of document.querySelectorAll<HTMLElement>('[data-galerie]')) {
    const champ = bloc.querySelector<HTMLElement>('[data-champ]')!;
    const legende = bloc.querySelector<HTMLElement>('[data-legende]')!;
    const legendeTitre = bloc.querySelector<HTMLElement>('[data-legende-titre]')!;
    const legendeCategorie = bloc.querySelector<HTMLElement>('[data-legende-categorie]')!;
    const items = [...bloc.querySelectorAll<HTMLElement>('.visuel')].map((el, i, tous) => ({
      el,
      bouton: el.querySelector<HTMLButtonElement>('button')!,
      x: Number(el.dataset.x),
      y: Number(el.dataset.y),
      z: (i * PROFONDEUR) / tous.length, // profondeur de départ, à égale distance
    }));

    // Caméra : au départ, le visuel le plus proche est à 380 px ; tous paraissent petits et lointains
    const cam = { z: -380, x: 0, y: 0, dx: 0, dy: 0 };
    const cible = { ...cam };
    let choisi: (typeof items)[number] | null = null;

    const dessiner = () => {
      const demiL = champ.clientWidth / 2;
      const demiH = champ.clientHeight / 2;
      // Le décalage reste limité : on ne perd jamais les visuels de vue
      cible.x = borne(cible.x, -demiL * 0.8, demiL * 0.8);
      cible.y = borne(cible.y, -demiH * 0.6, demiH * 0.6);
      for (const k of ['z', 'x', 'y', 'dx', 'dy'] as const) cam[k] += (cible[k] - cam[k]) * 0.08;

      for (const it of items) {
        const devant = modulo(it.z - cam.z, PROFONDEUR); // distance devant nous, de 0 à PROFONDEUR
        const x = it.x * demiL * etalement(devant) - cam.x - cam.dx;
        const y = it.y * demiH * etalement(devant) - cam.y - cam.dy;
        // « Brouillard » : au loin, le visuel pâlit (sans disparaître : il reste visible et cliquable) ;
        // il ne s'efface qu'au tout dernier moment, en arrivant au fond ou juste avant de passer derrière nous
        const loin = 1 - 0.7 * borne((devant - 700) / (PROFONDEUR - 1100), 0, 1);
        // Le visuel choisi peut venir tout près ; les autres s'effacent avant de devenir grands
        const proche = it === choisi ? borne(devant / 30, 0, 1) : borne((devant - RECUL / 2) / (RECUL / 2), 0, 1);
        const opacite = Math.min(loin, proche, borne((PROFONDEUR - devant) / 150, 0, 1));
        it.el.style.transform = `translate3d(${x}px, ${y}px, ${DECALAGE - devant}px) translate(-50%, -50%) scale(var(--echelle))`;
        it.el.style.opacity = String(opacite);
        it.el.style.zIndex = String(Math.round(PROFONDEUR - devant)); // le plus proche passe devant
        it.el.style.pointerEvents = opacite > 0.05 ? 'auto' : 'none';
      }
    };

    // Boucle d'affichage, seulement quand la galerie est à l'écran
    let visible = false;
    const boucle = () => {
      if (!visible || reduit.matches) return;
      dessiner();
      requestAnimationFrame(boucle);
    };
    new IntersectionObserver(([e]) => {
      const etait = visible;
      visible = e.isIntersecting;
      if (visible && !etait) requestAnimationFrame(boucle);
    }).observe(champ);

    // ── S'approcher d'un visuel / s'en éloigner ──────────────────────
    const choisir = (it: (typeof items)[number]) => {
      choisi = it;
      // La caméra avance jusqu'à PRES devant le visuel et se place en face de lui
      cible.z = cam.z + modulo(it.z - cam.z, PROFONDEUR) - PRES;
      cible.x = it.x * (champ.clientWidth / 2) * etalement(PRES);
      cible.y = it.y * (champ.clientHeight / 2) * etalement(PRES);
      items.forEach((i) => i.bouton.setAttribute('aria-pressed', String(i === it)));
      legendeCategorie.textContent = it.bouton.dataset.categorie ?? '';
      legendeTitre.textContent = it.bouton.dataset.titre ?? '';
      legende.classList.remove('cachee');
    };
    const relacher = (reculer: boolean) => {
      if (!choisi) return;
      choisi = null;
      if (reculer) cible.z -= 400; // on recule un peu : le visuel reprend sa place parmi les autres
      items.forEach((i) => i.bouton.setAttribute('aria-pressed', 'false'));
      legende.classList.add('cachee');
    };

    // Molette : avancer / reculer
    champ.addEventListener(
      'wheel',
      (e) => {
        if (reduit.matches) return;
        e.preventDefault();
        relacher(false);
        cible.z += e.deltaY * 1.2;
      },
      { passive: false },
    );

    // Glisser (souris ou doigt) : horizontal = se décaler, vertical = avancer / reculer
    let depart: { x: number; y: number } | null = null;
    let aGlisse = false;
    champ.addEventListener('pointerdown', (e) => {
      if (reduit.matches) return;
      depart = { x: e.clientX, y: e.clientY };
      aGlisse = false;
    });
    window.addEventListener('pointermove', (e) => {
      // Dérive : le champ suit légèrement la souris
      const r = champ.getBoundingClientRect();
      if (!depart && e.pointerType === 'mouse' && e.clientY > r.top && e.clientY < r.bottom) {
        cible.dx = ((e.clientX - r.left) / r.width - 0.5) * 2 * DERIVE;
        cible.dy = ((e.clientY - r.top) / r.height - 0.5) * 2 * DERIVE;
      }
      if (!depart) return;
      const dx = e.clientX - depart.x;
      const dy = e.clientY - depart.y;
      if (!aGlisse && Math.hypot(dx, dy) > 6) {
        aGlisse = true;
        champ.classList.add('en-glisse');
        relacher(false);
      }
      if (!aGlisse) return;
      cible.x -= dx;
      cible.z -= dy * 3;
      depart = { x: e.clientX, y: e.clientY };
    });
    window.addEventListener('pointerup', () => {
      depart = null;
      champ.classList.remove('en-glisse');
    });

    for (const it of items) {
      // Clic sur un visuel (même lointain) : on s'en approche ; nouveau clic dessus : on recule
      it.bouton.addEventListener('click', (e) => {
        e.stopPropagation();
        if (aGlisse || reduit.matches) return; // fin d'un glisser : pas de clic
        if (choisi === it) relacher(true);
        else choisir(it);
      });
      // Clavier (Tab) : on s'approche du visuel qui reçoit le focus
      it.bouton.addEventListener('focus', () => {
        if (!reduit.matches && it.bouton.matches(':focus-visible')) choisir(it);
      });
    }
    // Clic dans le vide ou touche Échap : on recule
    champ.addEventListener('click', () => !aGlisse && relacher(true));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && relacher(true));

    legende.classList.add('cachee');
    dessiner();
  }
</script>
